<?xml version="1.0" encoding="UTF-8"?>
<!-- XSLT GoogleShopping ver. 1.0 final (13.03.2019) https://support.google.com/merchants/answer/188494 -->
<!-- =====================================================================
     Wspólny sterownik: Grupa WP / Onet / Agora (format Google Merchant Center)
     ver. 2.0 (2026-10-07) - zmiany względem ver. 1.0:
     - cena omnibus (iaiext:omnibus_price_retail) ma pierwszeństwo - logika jak w sterowniku Google
     - g:sale_price zawsze (bez promocji = g:price), nowe pole g:omnibus_price
     - akcje: N najnowszych wartości parametru "Akcje" (domyślnie 20)
     - opis bez HTML, min. 100 znaków (dopełnienie nazwą, marką i parametrami), maks. 5000
     - poprawki: substring od 1 (title/opis), jedna g:google_product_category,
       g:product_type "A > B > C", g:size bez pustych/uniw, waga z jednostką kg,
       g:shipping z g:country, GTIN rozpoznawany także bez ustawionego standardu,
       g:mpn bez wstawiania własnego kodu towaru, g:identifier_exists,
       pomijanie produktów bez marki, <title>/<link> w channel
     ===================================================================== -->
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:iaiext="http://www.iai-shop.com/developers/iof/extensions.phtml" xmlns:g="http://base.google.com/ns/1.0" exclude-result-prefixes="iaiext">
	<xsl:output method="xml" version="1.0" encoding="UTF-8" indent="yes" cdata-section-elements="g:id title description g:google_product_category g:product_type link g:mobile_link g:display_ads_link g:image_link g:additional_image_link g:availability g:price g:sale_price g:omnibus_price g:gtin g:mpn g:brand g:size g:item_group_id g:condition g:shipping_weight adwords_grouping akcje"/>

	<!-- ========================= KONFIGURACJA ========================= -->
	<xsl:variable name="sklep_nazwa">ezebra.pl</xsl:variable>
	<xsl:variable name="sklep_url">https://ezebra.pl</xsl:variable>
	<!-- kraj dostawy dla g:shipping -->
	<xsl:variable name="kraj_dostawy">PL</xsl:variable>
	<!-- obniżka względem ceny omnibus musi przekraczać 1% -->
	<xsl:variable name="prog_obnizki" select="1.01"/>
	<!-- parametr z akcjami: id w panelu i liczba przekazywanych (najnowszych) wartości -->
	<xsl:variable name="akcje_id_parametru">92435</xsl:variable>
	<xsl:variable name="akcje_limit" select="20"/>
	<!-- opis -->
	<xsl:variable name="opis_min" select="100"/>
	<xsl:variable name="opis_max" select="5000"/>
	<xsl:variable name="opis_z_parametrow_max" select="1200"/>
	<!-- ================================================================ -->

	<xsl:template match="/">
		<rss xmlns:g="http://base.google.com/ns/1.0" version="2.0">
			<xsl:element name="channel">
				<title><xsl:value-of select="$sklep_nazwa"/></title>
				<link><xsl:value-of select="$sklep_url"/></link>
				<xsl:for-each select="offer/products/*">
					<!-- opis liczony raz na produkt -->
					<xsl:variable name="opis">
						<xsl:call-template name="opis-produktu"/>
					</xsl:variable>
					<xsl:for-each select="sizes/size">
						<xsl:if test="(../../description/name and ../../description/name != '')
							and normalize-space(../../producer/@name) != '' and ../../producer/@name != 'producent niezdefiniowany'
							and ((../../price/@gross &gt; 0) or (../../iaiext:pricecomparator_price/iaiext:site/@gross &gt; 0) or (iaiext:price/@gross &gt; 0))">
							<xsl:element name="item">
								<!-- Identyfikator towaru -->
								<xsl:element name="g:id"><xsl:value-of select="@code"/></xsl:element>
								<!-- Name -->
								<xsl:element name="title">
									<xsl:value-of select="normalize-space(substring(normalize-space(../../description/name), 1, 150))"/>
								</xsl:element>
								<!-- mark -->
								<xsl:for-each select="../../iaiext:hotspots/iaiext:site/flag">
								<xsl:choose>
									<xsl:when test="@type = 'promotion'">
										<xsl:element name="mark_sale">
											<xsl:value-of select="@type"/>
										</xsl:element>
									</xsl:when>
									<xsl:when test="@type = 'bestseller'">
										<xsl:element name="mark_bestseller">
											<xsl:value-of select="@type"/>
										</xsl:element>
									</xsl:when>
									<xsl:otherwise>
										<xsl:element name="mark">
											<xsl:value-of select="@type"/>
										</xsl:element>
									</xsl:otherwise>
								</xsl:choose>
								</xsl:for-each>
								<!-- Description -->
								<xsl:element name="description">
									<xsl:value-of select="$opis"/>
								</xsl:element>
								<!-- Category: jedna wartość (pierwsze mapowanie porównywarki), w razie braku ścieżka kategorii sklepu -->
								<xsl:choose>
									<xsl:when test="../../iaiext:price_compare_categories/iaiext:price_comparison[@category_id != '']">
										<xsl:element name="g:google_product_category">
											<xsl:value-of select="../../iaiext:price_compare_categories/iaiext:price_comparison[@category_id != ''][1]/@category_id"/>
										</xsl:element>
									</xsl:when>
									<xsl:when test="normalize-space(../../category[position() = last()]/@name) != ''">
										<xsl:element name="g:google_product_category">
											<xsl:value-of select="normalize-space(../../category[position() = last()]/@name)"/>
										</xsl:element>
									</xsl:when>
								</xsl:choose>
								<!-- Typ produktu: "Poziom 1 > Poziom 2 > Poziom 3" -->
								<xsl:element name="g:product_type">
									<xsl:call-template name="string-replace-all">
										<xsl:with-param name="text" select="normalize-space(../../category[position() = last()]/@name)"/>
										<xsl:with-param name="replace" select="'/'"/>
										<xsl:with-param name="by" select="' &gt; '"/>
									</xsl:call-template>
								</xsl:element>

								<!-- URL & URL Mobile -->
								<xsl:variable name="sizeID" select="@id"/>
								<xsl:variable name="urlProduct" select="../../card/@url"/>
								<xsl:variable name="urlProductMobile" select="../../card/@iaiext:url_mobile"/>
								<xsl:choose>
									<xsl:when test="contains($urlProduct, '/products/')">
										<xsl:element name="link">
											<xsl:choose>
												<xsl:when test="contains($urlProduct, 'feed')">
													<xsl:value-of select="concat(substring-before($urlProduct, 'feed'), 'html')"/>
													<xsl:if test="$sizeID != 'uniw'">?selected_size=<xsl:value-of select="$sizeID"/></xsl:if>
												</xsl:when>
												<xsl:otherwise>
													<xsl:value-of select="$urlProduct"/>
													<xsl:if test="$sizeID != 'uniw'">?selected_size=<xsl:value-of select="$sizeID"/></xsl:if>
												</xsl:otherwise>
											</xsl:choose>
										</xsl:element>
										<xsl:variable name="urlProductGoogle">
											<xsl:call-template name="substring-before-last">
												<xsl:with-param name="string1" select="$urlProduct"/>
												<xsl:with-param name="string2" select="'.'"/>
											</xsl:call-template>
										</xsl:variable>
										<xsl:variable name="urlProductSourceEmpty">
											<xsl:call-template name="substring-before-last">
												<xsl:with-param name="string1" select="$urlProductGoogle"/>
												<xsl:with-param name="string2" select="'.'"/>
											</xsl:call-template>
										</xsl:variable>
										<xsl:element name="g:display_ads_link">
											<xsl:value-of select="$urlProductSourceEmpty"/>.html<xsl:if test="$sizeID != 'uniw'">?selected_size=<xsl:value-of select="$sizeID"/></xsl:if>
										</xsl:element>
										<xsl:if test="$urlProductMobile">
											<xsl:element name="g:mobile_link">
												<xsl:value-of select="$urlProductMobile"/><xsl:if test="$sizeID != 'uniw'">?selected_size=<xsl:value-of select="$sizeID"/></xsl:if>
											</xsl:element>
										</xsl:if>
									</xsl:when>
									<xsl:otherwise>
										<xsl:variable name="link" select="substring-before($urlProduct,'.html')"/>
										<xsl:variable name="link0001" select="substring-before($link,'/product-')"/>
										<xsl:variable name="link0002" select="substring-after($urlProduct,'/product')"/>
										<xsl:variable name="link0003" select="substring-before($link0002,'.')"/>
										<xsl:variable name="link0004" select="substring-after($link0002,'.')"/>
										<xsl:variable name="sep"><![CDATA[-]]></xsl:variable>
										<xsl:variable name="mlink" select="substring-before($urlProductMobile,'.html')"/>
										<xsl:variable name="link0011" select="substring-before($mlink,'/product-')"/>
										<xsl:variable name="link0012" select="substring-after($urlProductMobile,'/product')"/>
										<xsl:variable name="link0013" select="substring-before($link0012,'.')"/>
										<xsl:variable name="link0014" select="substring-after($link0012,'.')"/>
										<xsl:element name="link">
											<xsl:value-of select="$link0001"/><xsl:text>/product</xsl:text><xsl:value-of select="$link0003"/><xsl:value-of select="$sep"/><xsl:value-of select="$sizeID"/><xsl:text>.</xsl:text><xsl:value-of select="$link0004"/>
										</xsl:element>
										<xsl:element name="g:display_ads_link">
											<xsl:value-of select="$link0001"/><xsl:text>/product</xsl:text><xsl:value-of select="$link0003"/><xsl:value-of select="$sep"/><xsl:value-of select="$sizeID"/><xsl:text>.html</xsl:text>
										</xsl:element>
										<xsl:if test="../../card/@iaiext:url_mobile">
											<xsl:element name="g:mobile_link">
												<xsl:value-of select="$link0011"/><xsl:text>/product</xsl:text><xsl:value-of select="$link0013"/><xsl:value-of select="$sep"/><xsl:value-of select="$sizeID"/><xsl:text>.</xsl:text><xsl:value-of select="$link0014"/>
											</xsl:element>
										</xsl:if>
									</xsl:otherwise>
								</xsl:choose>
								<!-- IMG -->
								<xsl:choose>
									<xsl:when test="../../images/large/image">
										<xsl:for-each select="../../images/large/image[position() &lt;= 10]">
											<xsl:choose>
												<xsl:when test="position() = 1">
													<xsl:element name="g:image_link">
														<xsl:value-of select="@url"/>
													</xsl:element>
												</xsl:when>
												<xsl:otherwise>
													<xsl:element name="g:additional_image_link">
														<xsl:value-of select="@url"/>
													</xsl:element>
												</xsl:otherwise>
											</xsl:choose>
										</xsl:for-each>
									</xsl:when>
									<xsl:otherwise>
										<xsl:element name="g:image_link">
											<xsl:variable name="link_product_card" select="../../card/@url"/>
											<xsl:variable name="no_image"><![CDATA[/eng_il-default-1.png]]></xsl:variable>
											<xsl:choose>
												<xsl:when test="contains($link_product_card, '/products/')">
													<xsl:variable name="domainUrl">
														<xsl:call-template name="substring-before-last">
															<xsl:with-param name="string1" select="substring-before($link_product_card, '/products/')"/>
															<xsl:with-param name="string2" select="'/'"/>
														</xsl:call-template>
													</xsl:variable>
													<xsl:value-of select="$domainUrl"/><xsl:value-of select="$no_image"/>
												</xsl:when>
												<xsl:otherwise>
													<xsl:value-of select="substring-before($link_product_card,'/product-')"/><xsl:value-of select="$no_image"/>
												</xsl:otherwise>
											</xsl:choose>
										</xsl:element>
									</xsl:otherwise>
								</xsl:choose>
								<!-- Stan -->
								<xsl:variable name="stan">
									<xsl:for-each select="../../parameters/parameter[@context_id = 'CONTEXT_STATE'][1]">
										<xsl:choose>
											<xsl:when test="value[@context_id = 'CONTEXT_STATE_USED'] or value[@context_id = 'CONTEXT_STATE_FOR_PARTS_OR_BROKEN'] or value[@context_id = 'CONTEXT_STATE_NEW_WITH_DEFECTS']">used</xsl:when>
											<xsl:when test="value[@context_id = 'CONTEXT_STATE_REFURBISHED_BY_PRODUCER'] or value[@context_id = 'CONTEXT_STATE_REFURBISHED_BY_SELLER']">refurbished</xsl:when>
										</xsl:choose>
									</xsl:for-each>
								</xsl:variable>
								<xsl:element name="g:condition">
									<xsl:choose>
										<xsl:when test="$stan != ''"><xsl:value-of select="$stan"/></xsl:when>
										<xsl:otherwise>new</xsl:otherwise>
									</xsl:choose>
								</xsl:element>
								<!-- Availability -->
								<xsl:element name="g:availability">
									<xsl:variable name="unit" select="../../iaiext:delivery_time/@unit"/>
									<xsl:variable name="days" select="../../iaiext:delivery_time/@value"/>
									<xsl:choose>
										<xsl:when test="stock/@id &gt;= 1">in stock</xsl:when>
										<xsl:when test="stock/@id = 0">
											<xsl:choose>
												<xsl:when test="($unit = 'day' and $days &lt;= 3) or ($unit = 'hour' and $days &lt;= 72) or ($unit = 'minute' and $days &lt;= 4320)">in stock</xsl:when>
												<xsl:when test="($unit = 'day' and $days &gt; 3) or ($unit = 'hour' and $days &gt; 72) or ($unit = 'minute' and $days &gt; 4320)">preorder</xsl:when>
												<xsl:otherwise>out of stock</xsl:otherwise>
											</xsl:choose>
										</xsl:when>
										<xsl:when test="stock/@id = -2">preorder</xsl:when>
										<xsl:otherwise>out of stock</xsl:otherwise>
									</xsl:choose>
								</xsl:element>

								<!-- ===================== Price / Sale Price / Omnibus ===================== -->
								<xsl:variable name="currencyPrice" select="../../@currency"/>
								<xsl:variable name="cena_serwis">
									<xsl:choose>
										<xsl:when test="../../iaiext:pricecomparator_price/iaiext:site">
											<xsl:value-of select="../../iaiext:pricecomparator_price/iaiext:site/@gross"/>
										</xsl:when>
										<xsl:otherwise>
											<xsl:text>0</xsl:text>
										</xsl:otherwise>
									</xsl:choose>
								</xsl:variable>
								<!-- cena regularna wg dotychczasowej logiki (używana, gdy brak ceny omnibus) -->
								<xsl:variable name="mainPrice">
									<xsl:choose>
										<xsl:when test="../../strikethrough_retail_price and  ../../strikethrough_retail_price/@gross > 0 and
										  ../../strikethrough_retail_price/@gross > price/@gross and
										  price/@gross = ../../price/@gross and
										  ../../strikethrough_retail_price/@gross > $cena_serwis">
											<xsl:value-of select="../../strikethrough_retail_price/@gross"/>
										</xsl:when>
										<xsl:when test="../../iaiext:pricecomparator_price/iaiext:site and ../../price/@gross = price/@gross">
											<xsl:choose>
												<xsl:when test="../../promotion/price/normal_retail_price/@gross > ../../iaiext:pricecomparator_price/iaiext:site/@gross">
													<xsl:value-of select="../../promotion/price/normal_retail_price/@gross"/>
												</xsl:when>
												<xsl:otherwise>
													<xsl:value-of select="../../iaiext:pricecomparator_price/iaiext:site/@gross"/>
												</xsl:otherwise>
											</xsl:choose>
										</xsl:when>
										<xsl:when test="price/@gross">
											<xsl:choose>
												<xsl:when test="price/@gross != ../../price/@gross and
												../../promotion/price/normal_retail_price/iaiext:site/iaiext:price_per_size[@id = $sizeID]/@gross > price/@gross">
													<xsl:value-of select="../../promotion/price/normal_retail_price/iaiext:site/iaiext:price_per_size[@id = $sizeID]/@gross"/>
												</xsl:when>
												<xsl:when test="price/@gross = ../../price/@gross and
												../../promotion/price/normal_retail_price/@gross > price/@gross">
													<xsl:value-of select="../../promotion/price/normal_retail_price/@gross"/>
												</xsl:when>
												<xsl:otherwise>
													<xsl:value-of select="price/@gross"/>
												</xsl:otherwise>
											</xsl:choose>
										</xsl:when>
										<xsl:otherwise>
											<xsl:value-of select="../../price/@gross"/>
										</xsl:otherwise>
									</xsl:choose>
								</xsl:variable>
								<!-- czy wg dotychczasowej logiki jest promocja / cena przekreślona -->
								<xsl:variable name="isPromo" select="
									  (../../strikethrough_retail_price and ../../strikethrough_retail_price/@gross > price/@gross) or
									  (../../promotion/price/normal_retail_price and ../../promotion/price/normal_retail_price/@gross > price/@gross) or
									  (../../promotion/price/normal_retail_price and ../../price/@gross != price/@gross and
									  ../../promotion/price/normal_retail_price/iaiext:site/iaiext:price_per_size[@id = $sizeID]/@gross > price/@gross)"/>
								<!-- cena aktualna rozmiaru -->
								<xsl:variable name="cena_aktualna">
									<xsl:choose>
										<xsl:when test="price/@gross &gt; 0"><xsl:value-of select="price/@gross"/></xsl:when>
										<xsl:otherwise><xsl:value-of select="$mainPrice"/></xsl:otherwise>
									</xsl:choose>
								</xsl:variable>
								<!-- cena omnibus (najniższa z 30 dni) - ma pierwszeństwo -->
								<xsl:variable name="omnibus">
									<xsl:choose>
										<xsl:when test="../../iaiext:omnibus_price_retail/iaiext:site/@gross != '' and ../../iaiext:omnibus_price_retail/iaiext:site/@gross &gt; 0">
											<xsl:value-of select="../../iaiext:omnibus_price_retail/iaiext:site/@gross"/>
										</xsl:when>
										<xsl:otherwise>0</xsl:otherwise>
									</xsl:choose>
								</xsl:variable>

								<xsl:variable name="cena_regularna">
									<xsl:choose>
										<!-- obniżka względem omnibusa > 1%: cena regularna = omnibus -->
										<xsl:when test="$omnibus &gt; 0 and $omnibus &gt; $cena_aktualna and ($omnibus div $cena_aktualna) &gt; $prog_obnizki">
											<xsl:value-of select="$omnibus"/>
										</xsl:when>
										<!-- omnibus jest, ale bez realnej obniżki -->
										<xsl:when test="$omnibus &gt; 0">
											<xsl:value-of select="$cena_aktualna"/>
										</xsl:when>
										<!-- brak omnibusa: dotychczasowa logika -->
										<xsl:otherwise>
											<xsl:value-of select="$mainPrice"/>
										</xsl:otherwise>
									</xsl:choose>
								</xsl:variable>
								<xsl:variable name="cena_sprzedazy">
									<xsl:choose>
										<xsl:when test="$omnibus &gt; 0">
											<xsl:value-of select="$cena_aktualna"/>
										</xsl:when>
										<xsl:when test="$isPromo and price/@gross &gt; 0">
											<xsl:value-of select="price/@gross"/>
										</xsl:when>
										<xsl:otherwise>
											<xsl:value-of select="$cena_regularna"/>
										</xsl:otherwise>
									</xsl:choose>
								</xsl:variable>
								<xsl:variable name="cena_omnibus">
									<xsl:choose>
										<xsl:when test="$omnibus &gt; 0"><xsl:value-of select="$omnibus"/></xsl:when>
										<xsl:otherwise><xsl:value-of select="$cena_regularna"/></xsl:otherwise>
									</xsl:choose>
								</xsl:variable>

								<g:price>
									<xsl:value-of select="$cena_regularna"/>
									<xsl:text> </xsl:text>
									<xsl:value-of select="$currencyPrice"/>
								</g:price>
								<g:sale_price>
									<xsl:value-of select="$cena_sprzedazy"/>
									<xsl:text> </xsl:text>
									<xsl:value-of select="$currencyPrice"/>
								</g:sale_price>
								<g:omnibus_price>
									<xsl:value-of select="$cena_omnibus"/>
									<xsl:text> </xsl:text>
									<xsl:value-of select="$currencyPrice"/>
								</g:omnibus_price>

								<!-- Gtin / MPN -->
								<xsl:variable name="std" select="../../@producer_code_standard"/>
								<xsl:variable name="kod" select="normalize-space(@code_producer)"/>
								<xsl:variable name="kod_cyfrowy" select="$kod != '' and translate($kod, '0123456789', '') = '' and
									(string-length($kod) = 8 or string-length($kod) = 12 or string-length($kod) = 13 or string-length($kod) = 14)"/>
								<xsl:variable name="gtin">
									<xsl:choose>
										<xsl:when test="($std = 'GTIN8' or $std = 'GTIN12' or $std = 'GTIN13' or $std = 'GTIN14' or $std = 'UPCE' or $std = 'ISBN10' or $std = 'ISBN13') and $kod != ''">
											<xsl:value-of select="$kod"/>
										</xsl:when>
										<!-- brak standardu, ale kod wygląda jak EAN/GTIN -->
										<xsl:when test="($std = '' or not($std)) and $kod_cyfrowy">
											<xsl:value-of select="$kod"/>
										</xsl:when>
									</xsl:choose>
								</xsl:variable>
								<xsl:variable name="mpn">
									<xsl:if test="$gtin = ''">
										<xsl:choose>
											<xsl:when test="$kod != ''"><xsl:value-of select="$kod"/></xsl:when>
											<xsl:when test="normalize-space(@code_external) != ''"><xsl:value-of select="normalize-space(@code_external)"/></xsl:when>
											<xsl:when test="normalize-space(../../@code_producer) != ''"><xsl:value-of select="normalize-space(../../@code_producer)"/></xsl:when>
										</xsl:choose>
									</xsl:if>
								</xsl:variable>
								<xsl:if test="$gtin != ''">
									<xsl:element name="g:gtin"><xsl:value-of select="$gtin"/></xsl:element>
								</xsl:if>
								<xsl:if test="$mpn != ''">
									<xsl:element name="g:mpn"><xsl:value-of select="$mpn"/></xsl:element>
								</xsl:if>
								<xsl:if test="$gtin = '' and $mpn = ''">
									<xsl:element name="g:identifier_exists">no</xsl:element>
								</xsl:if>
								<!-- Producer -->
								<xsl:element name="g:brand">
									<xsl:value-of select="normalize-space(../../producer/@name)"/>
								</xsl:element>
								<!-- Rozmiar (bez pustych i uniwersalnych) -->
								<xsl:if test="$sizeID != 'uniw' and normalize-space(@name) != ''">
									<xsl:element name="g:size">
										<xsl:value-of select="normalize-space(@name)"/>
									</xsl:element>
								</xsl:if>
								<!-- Grupa -->
								<xsl:element name="g:item_group_id">
									<xsl:value-of select="../../@id"/>
								</xsl:element>
								<!-- Koszt dostawy -->
								<xsl:if test="price/price_marketplace_site/delivery_cost/prepayment/@gross != ''">
									<xsl:element name="g:shipping">
										<xsl:element name="g:country"><xsl:value-of select="$kraj_dostawy"/></xsl:element>
										<xsl:element name="g:price">
											<xsl:value-of select="price/price_marketplace_site/delivery_cost/prepayment/@gross"/><xsl:text> </xsl:text><xsl:value-of select="$currencyPrice"/>
										</xsl:element>
									</xsl:element>
								</xsl:if>
								<!-- Waga (IdoSell podaje gramy) -->
								<xsl:if test="@weight &gt; 0">
									<xsl:element name="g:shipping_weight">
										<xsl:value-of select="format-number(@weight div 1000, '0.###')"/><xsl:text> kg</xsl:text>
									</xsl:element>
								</xsl:if>
								<!-- Atrybuty -->
								<xsl:for-each select="../../parameters/parameter[@context_id = 'CONTEXT_SEX'][1]">
									<xsl:choose>
										<xsl:when test="value[@context_id = 'CONTEXT_SEX_MAN']">
											<xsl:element name="g:gender"><![CDATA[male]]></xsl:element>
										</xsl:when>
										<xsl:when test="value[@context_id = 'CONTEXT_SEX_WOMAN']">
											<xsl:element name="g:gender"><![CDATA[female]]></xsl:element>
										</xsl:when>
										<xsl:when test="value[@context_id = 'CONTEXT_SEX_UNISEX']">
											<xsl:element name="g:gender"><![CDATA[unisex]]></xsl:element>
										</xsl:when>
										<xsl:otherwise/>
									</xsl:choose>
								</xsl:for-each>
								<xsl:for-each select="../../parameters/parameter[@context_id = 'CONTEXT_AGE_GROUP'][1]">
									<xsl:choose>
										<xsl:when test="value[@context_id = 'CONTEXT_AGE_GROUP_ADULT']">
											<xsl:element name="g:age_group"><![CDATA[adult]]></xsl:element>
										</xsl:when>
										<xsl:when test="value[@context_id = 'CONTEXT_AGE_GROUP_MINOR']">
											<xsl:element name="g:age_group"><![CDATA[kids]]></xsl:element>
										</xsl:when>
										<xsl:otherwise/>
									</xsl:choose>
								</xsl:for-each>
								<!-- Kolor: jedna wartość, maks. 3 kolory rozdzielone "/" (wymóg Google) -->
								<xsl:if test="../../parameters/parameter[@context_id = 'CONTEXT_COLOR']/value/@name != ''">
									<xsl:element name="g:color">
										<xsl:for-each select="../../parameters/parameter[@context_id = 'CONTEXT_COLOR'][1]/value[position() &lt;= 3]">
											<xsl:if test="position() &gt; 1">/</xsl:if>
											<xsl:value-of select="@name"/>
										</xsl:for-each>
									</xsl:element>
								</xsl:if>
								<xsl:for-each select="../../parameters/parameter[@context_id = 'CONTEXT_ONLY_ADULTS'][1]">
									<xsl:choose>
										<xsl:when test="value[@context_id = 'CONTEXT_ONLY_ADULTS_YES']">
											<xsl:element name="g:adult"><![CDATA[yes]]></xsl:element>
										</xsl:when>
										<xsl:when test="value[@context_id = 'CONTEXT_ONLY_ADULTS_NO']">
											<xsl:element name="g:adult"><![CDATA[no]]></xsl:element>
										</xsl:when>
										<xsl:otherwise/>
									</xsl:choose>
								</xsl:for-each>

								<!-- Akcje: najnowsze wartości parametru (od końca listy), maks. $akcje_limit -->
								<xsl:for-each select="../../parameters/parameter[@hide = 'n' and value[1]/@name != '' and @id = $akcje_id_parametru][1]">
									<xsl:variable name="count" select="count(value)"/>
									<xsl:for-each select="value[position() &lt;= $akcje_limit]">
										<xsl:variable name="revPos" select="$count - position() + 1"/>
										<xsl:for-each select="../value[$revPos]">
											<xsl:if test="normalize-space(@name) != ''">
												<xsl:element name="akcje">
													<xsl:value-of select="normalize-space(@name)"/>
												</xsl:element>
											</xsl:if>
										</xsl:for-each>
									</xsl:for-each>
								</xsl:for-each>

								<!-- CUSTOM_LABEL_4 - Black Days: wartości parametru 91508 „Black Friday”, po przecinku, max 100 znaków (black_days_2026-11-06; numer jak w feedach Meta) -->
								<xsl:variable name="black_days">
									<xsl:for-each select="../../parameters/parameter[@id = '91508']/value[normalize-space(@name) != '']">
										<xsl:text>, </xsl:text>
										<xsl:value-of select="normalize-space(@name)"/>
									</xsl:for-each>
								</xsl:variable>
								<xsl:if test="$black_days != ''">
									<xsl:element name="g:custom_label_4">
										<xsl:value-of select="substring(substring($black_days, 3), 1, 100)"/>
									</xsl:element>
								</xsl:if>

								<xsl:element name="adwords_grouping">
									<xsl:choose>
										<xsl:when test="contains(../../category/@name, '*')">
											<xsl:value-of select="substring-after(../../category/@name, '*')"/>
										</xsl:when>
										<xsl:otherwise>
											<xsl:variable name="rcategory" select="normalize-space(../../category/@name)"/>
											<xsl:variable name="rcat" select="substring-before($rcategory, '/')"/>
											<xsl:if test="$rcat=''"><xsl:value-of select="$rcategory"/></xsl:if>
											<xsl:if test="$rcat !=''"><xsl:value-of select="$rcat"/></xsl:if>
										</xsl:otherwise>
									</xsl:choose>
								</xsl:element>
							</xsl:element>
						</xsl:if>
					</xsl:for-each>
				</xsl:for-each>
			</xsl:element>
		</rss>
	</xsl:template>

	<!-- ============================ OPIS ============================== -->
	<!-- kontekst: product. Krótki opis (jeśli >= 100 znaków) → długi opis bez HTML →
	     dopełnienie nazwą, marką i parametrami, jeśli wciąż < 100 znaków -->
	<xsl:template name="opis-produktu">
		<xsl:variable name="krotki">
			<xsl:call-template name="html-do-tekstu">
				<xsl:with-param name="text" select="description/short_desc"/>
			</xsl:call-template>
		</xsl:variable>
		<xsl:variable name="dlugi">
			<xsl:call-template name="html-do-tekstu">
				<xsl:with-param name="text" select="description/long_desc"/>
			</xsl:call-template>
		</xsl:variable>
		<xsl:variable name="baza">
			<xsl:choose>
				<xsl:when test="string-length($krotki) &gt;= $opis_min">
					<xsl:call-template name="utnij-do-zdania">
						<xsl:with-param name="text" select="$krotki"/>
					</xsl:call-template>
				</xsl:when>
				<xsl:when test="string-length($dlugi) &gt; string-length($krotki)">
					<xsl:call-template name="utnij-do-zdania">
						<xsl:with-param name="text" select="$dlugi"/>
					</xsl:call-template>
				</xsl:when>
				<xsl:otherwise><xsl:value-of select="$krotki"/></xsl:otherwise>
			</xsl:choose>
		</xsl:variable>
		<xsl:value-of select="$baza"/>
		<xsl:if test="string-length($baza) &lt; $opis_min">
			<xsl:variable name="parametry">
				<xsl:for-each select="parameters/parameter[@hide = 'n' and value/@name != '' and not(@id = $akcje_id_parametru)]">
					<xsl:text>&#xa;</xsl:text>
					<xsl:value-of select="@name"/>
					<xsl:text>: </xsl:text>
					<xsl:for-each select="value">
						<xsl:if test="position() &gt; 1">, </xsl:if>
						<xsl:value-of select="@name"/>
					</xsl:for-each>
				</xsl:for-each>
			</xsl:variable>
			<xsl:if test="$baza != ''"><xsl:text>&#xa;</xsl:text></xsl:if>
			<xsl:value-of select="normalize-space(description/name)"/>
			<xsl:text>&#xa;Marka: </xsl:text>
			<xsl:value-of select="normalize-space(producer/@name)"/>
			<xsl:value-of select="substring($parametry, 1, $opis_z_parametrow_max)"/>
		</xsl:if>
	</xsl:template>

	<!-- HTML (tekst z IdoSell) → czysty tekst z zachowaniem akapitów -->
	<xsl:template name="html-do-tekstu">
		<xsl:param name="text"/>
		<xsl:variable name="s1">
			<xsl:call-template name="strip-tags">
				<xsl:with-param name="text" select="$text"/>
				<xsl:with-param name="open" select="'&lt;!--'"/>
				<xsl:with-param name="close" select="'--&gt;'"/>
			</xsl:call-template>
		</xsl:variable>
		<xsl:variable name="s2">
			<xsl:call-template name="strip-tags">
				<xsl:with-param name="text" select="$s1"/>
				<xsl:with-param name="open" select="'&lt;style'"/>
				<xsl:with-param name="close" select="'&lt;/style&gt;'"/>
			</xsl:call-template>
		</xsl:variable>
		<xsl:variable name="s3">
			<xsl:call-template name="strip-tags">
				<xsl:with-param name="text" select="$s2"/>
				<xsl:with-param name="open" select="'&lt;script'"/>
				<xsl:with-param name="close" select="'&lt;/script&gt;'"/>
			</xsl:call-template>
		</xsl:variable>
		<!-- końce bloków → nowa linia -->
		<xsl:variable name="s4">
			<xsl:call-template name="multi-replace">
				<xsl:with-param name="text" select="$s3"/>
				<xsl:with-param name="pairs" select="'&lt;br&gt;§&#xa;¦&lt;br/&gt;§&#xa;¦&lt;br /&gt;§&#xa;¦&lt;/p&gt;§&#xa;¦&lt;/li&gt;§&#xa;¦&lt;/h1&gt;§&#xa;¦&lt;/h2&gt;§&#xa;¦&lt;/h3&gt;§&#xa;¦&lt;/h4&gt;§&#xa;¦&lt;/div&gt;§&#xa;¦'"/>
			</xsl:call-template>
		</xsl:variable>
		<xsl:variable name="s5">
			<xsl:call-template name="strip-tags">
				<xsl:with-param name="text" select="$s4"/>
			</xsl:call-template>
		</xsl:variable>
		<!-- encje HTML -->
		<xsl:variable name="s6">
			<xsl:call-template name="multi-replace">
				<xsl:with-param name="text" select="$s5"/>
				<xsl:with-param name="pairs" select="'&amp;nbsp;§ ¦&amp;quot;§&quot;¦&amp;lt;§&lt;¦&amp;gt;§&gt;¦&amp;oacute;§ó¦&amp;Oacute;§Ó¦&amp;eacute;§é¦&amp;bdquo;§„¦&amp;rdquo;§”¦&amp;ldquo;§“¦&amp;rsquo;§’¦&amp;lsquo;§‘¦&amp;ndash;§-¦&amp;mdash;§-¦&amp;reg;§®¦&amp;trade;§™¦&amp;copy;§©¦&amp;deg;§°¦&amp;amp;§&amp;¦'"/>
			</xsl:call-template>
		</xsl:variable>
		<xsl:call-template name="tidy-newlines">
			<xsl:with-param name="text" select="$s6"/>
		</xsl:call-template>
	</xsl:template>

	<!-- tnie do $opis_max znaków, kończąc na ostatniej pełnej kropce -->
	<xsl:template name="utnij-do-zdania">
		<xsl:param name="text"/>
		<xsl:choose>
			<xsl:when test="string-length($text) &lt;= $opis_max"><xsl:value-of select="$text"/></xsl:when>
			<xsl:otherwise>
				<xsl:variable name="cut" select="substring($text, 1, $opis_max)"/>
				<xsl:variable name="do_kropki">
					<xsl:call-template name="substring-before-last">
						<xsl:with-param name="string1" select="$cut"/>
						<xsl:with-param name="string2" select="'.'"/>
					</xsl:call-template>
				</xsl:variable>
				<xsl:choose>
					<xsl:when test="string-length($do_kropki) &gt; $opis_min"><xsl:value-of select="$do_kropki"/>.</xsl:when>
					<xsl:otherwise><xsl:value-of select="$cut"/></xsl:otherwise>
				</xsl:choose>
			</xsl:otherwise>
		</xsl:choose>
	</xsl:template>

	<!-- ========================= HELPERY ============================== -->
	<xsl:template name="strip-tags">
		<xsl:param name="text"/>
		<xsl:param name="open" select="'&lt;'"/>
		<xsl:param name="close" select="'&gt;'"/>
		<xsl:param name="depth" select="0"/>
		<xsl:choose>
			<xsl:when test="contains($text, $open) and contains(substring-after($text, $open), $close) and $depth &lt; 1200">
				<xsl:value-of select="substring-before($text, $open)"/>
				<xsl:text> </xsl:text>
				<xsl:call-template name="strip-tags">
					<xsl:with-param name="text" select="substring-after(substring-after($text, $open), $close)"/>
					<xsl:with-param name="open" select="$open"/>
					<xsl:with-param name="close" select="$close"/>
					<xsl:with-param name="depth" select="$depth + 1"/>
				</xsl:call-template>
			</xsl:when>
			<xsl:otherwise><xsl:value-of select="$text"/></xsl:otherwise>
		</xsl:choose>
	</xsl:template>

	<xsl:template name="string-replace-all">
		<xsl:param name="text"/>
		<xsl:param name="replace"/>
		<xsl:param name="by"/>
		<xsl:param name="depth" select="0"/>
		<xsl:choose>
			<xsl:when test="$replace != '' and contains($text, $replace) and $depth &lt; 1000">
				<xsl:value-of select="substring-before($text, $replace)"/>
				<xsl:value-of select="$by"/>
				<xsl:call-template name="string-replace-all">
					<xsl:with-param name="text" select="substring-after($text, $replace)"/>
					<xsl:with-param name="replace" select="$replace"/>
					<xsl:with-param name="by" select="$by"/>
					<xsl:with-param name="depth" select="$depth + 1"/>
				</xsl:call-template>
			</xsl:when>
			<xsl:otherwise><xsl:value-of select="$text"/></xsl:otherwise>
		</xsl:choose>
	</xsl:template>

	<!-- seria zamian: 'szukane§zamiana¦szukane§zamiana¦...' -->
	<xsl:template name="multi-replace">
		<xsl:param name="text"/>
		<xsl:param name="pairs"/>
		<xsl:choose>
			<xsl:when test="contains($pairs, '¦')">
				<xsl:variable name="pair" select="substring-before($pairs, '¦')"/>
				<xsl:variable name="po">
					<xsl:call-template name="string-replace-all">
						<xsl:with-param name="text" select="$text"/>
						<xsl:with-param name="replace" select="substring-before($pair, '§')"/>
						<xsl:with-param name="by" select="substring-after($pair, '§')"/>
					</xsl:call-template>
				</xsl:variable>
				<xsl:call-template name="multi-replace">
					<xsl:with-param name="text" select="$po"/>
					<xsl:with-param name="pairs" select="substring-after($pairs, '¦')"/>
				</xsl:call-template>
			</xsl:when>
			<xsl:otherwise><xsl:value-of select="$text"/></xsl:otherwise>
		</xsl:choose>
	</xsl:template>

	<!-- porządkuje białe znaki, zachowując pojedyncze przejścia do nowej linii -->
	<xsl:template name="tidy-newlines">
		<xsl:param name="text"/>
		<xsl:variable name="marked">
			<xsl:call-template name="string-replace-all">
				<xsl:with-param name="text" select="translate($text, '&#xd;', '')"/>
				<xsl:with-param name="replace" select="'&#xa;'"/>
				<xsl:with-param name="by" select="'|#NL#|'"/>
			</xsl:call-template>
		</xsl:variable>
		<xsl:variable name="clean">
			<xsl:call-template name="multi-replace">
				<xsl:with-param name="text" select="normalize-space($marked)"/>
				<xsl:with-param name="pairs" select="' |#NL#|§|#NL#|¦|#NL#| §|#NL#|¦'"/>
			</xsl:call-template>
		</xsl:variable>
		<xsl:variable name="single">
			<xsl:call-template name="collapse-nl">
				<xsl:with-param name="text" select="$clean"/>
			</xsl:call-template>
		</xsl:variable>
		<xsl:variable name="no_lead">
			<xsl:choose>
				<xsl:when test="starts-with($single, '|#NL#|')"><xsl:value-of select="substring($single, 7)"/></xsl:when>
				<xsl:otherwise><xsl:value-of select="$single"/></xsl:otherwise>
			</xsl:choose>
		</xsl:variable>
		<xsl:variable name="trimmed">
			<xsl:choose>
				<xsl:when test="substring($no_lead, string-length($no_lead) - 5) = '|#NL#|'">
					<xsl:value-of select="substring($no_lead, 1, string-length($no_lead) - 6)"/>
				</xsl:when>
				<xsl:otherwise><xsl:value-of select="$no_lead"/></xsl:otherwise>
			</xsl:choose>
		</xsl:variable>
		<xsl:call-template name="string-replace-all">
			<xsl:with-param name="text" select="$trimmed"/>
			<xsl:with-param name="replace" select="'|#NL#|'"/>
			<xsl:with-param name="by" select="'&#xa;'"/>
		</xsl:call-template>
	</xsl:template>

	<xsl:template name="collapse-nl">
		<xsl:param name="text"/>
		<xsl:param name="depth" select="0"/>
		<xsl:choose>
			<xsl:when test="contains($text, '|#NL#||#NL#|') and $depth &lt; 50">
				<xsl:call-template name="collapse-nl">
					<xsl:with-param name="text">
						<xsl:call-template name="string-replace-all">
							<xsl:with-param name="text" select="$text"/>
							<xsl:with-param name="replace" select="'|#NL#||#NL#|'"/>
							<xsl:with-param name="by" select="'|#NL#|'"/>
						</xsl:call-template>
					</xsl:with-param>
					<xsl:with-param name="depth" select="$depth + 1"/>
				</xsl:call-template>
			</xsl:when>
			<xsl:otherwise><xsl:value-of select="$text"/></xsl:otherwise>
		</xsl:choose>
	</xsl:template>

	<xsl:template name="substring-before-last">
		<xsl:param name="string1" select="''" />
		<xsl:param name="string2" select="''" />
		<xsl:if test="$string1 != '' and $string2 != ''">
			<xsl:variable name="head" select="substring-before($string1, $string2)" />
			<xsl:variable name="tail" select="substring-after($string1, $string2)" />
			<xsl:value-of select="$head" />
			<xsl:if test="contains($tail, $string2)">
				<xsl:value-of select="$string2" />
				<xsl:call-template name="substring-before-last">
					<xsl:with-param name="string1" select="$tail" />
					<xsl:with-param name="string2" select="$string2" />
				</xsl:call-template>
			</xsl:if>
		</xsl:if>
	</xsl:template>
</xsl:stylesheet>