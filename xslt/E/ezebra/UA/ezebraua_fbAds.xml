<?xml version="1.0" encoding="UTF-8"?>
<!--
     Sterownik feeda Meta – ezebra.com.ua (wersja poprawiona)
     Zmiany względem poprzedniej wersji:
     1. Produkty bez nazwy (brak tłumaczenia UA) są pomijane – nie trafiają do Meta jako odrzucone.
     2. Opis: fallback short_desc -> long_desc -> tytuł (Meta wymaga niepustego description).
     3. Usunięte spacje / znaki nowej linii z availability, condition, price, sale_price, link, kategorii.
     4. Dodany blok GTIN / MPN (jak w feedzie PL).
     5. g:price / g:sale_price jak w PL; sale_price tylko gdy jest realnie niższa od price.
     6. Poprawione dopasowanie ceny per rozmiar ($size_id zamiast dowolnego rozmiaru).
     7. Usunięty "sentence case" (psuł zapis linii produktowych, np. CHRONO AGE, SPF, Q10).
-->
<xsl:stylesheet version="1.0"
                xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
                xmlns:iaiext="http://www.iai-shop.com/developers/iof/extensions.phtml"
                xmlns:php="http://php.net/xsl">
    
    <xsl:output method="xml" version="1.0" encoding="UTF-8" indent="yes" cdata-section-elements="cat name desc a"/>
    
    <!-- PL|DE|CZ|SK|RO|UA||||||||||||||||||||||||||||||| -->
    <xsl:variable name="upperLetters" 
                  select="'AĄBCĆDEĘFGHIJKLŁMNŃOÓPQRSŚTUVWXYZŹŻÄÖÜẞÁČĎÉĚÍŇÓŘŠŤÚŮÝŽÁÄČĎŽÉÍĹĽŇÓÔŔŠŤÚÝŽĂÂÎȘȚАБВГҐДЕЄЖЗИІЇЙКЛМНОПРСТУФХЦЧШЩЬЮЯ'" />
    <xsl:variable name="lowerLetters" 
                  select="'aąbcćdeęfghijklłmnńoópqrsśtuvwxyzźżäöüßáčďéěíňóřšťúůýžáäčďžéíĺľňóôŕšťúýžăâîșțабвгґдеєжзиіїйклмнопрстуфхцчшщьюя'" />

    <!-- słowa formatowane do pisanych z jednej dużej litery w tytule -->
    <xsl:variable name="corrected" select="'\GRATIS\'" />

    <xsl:template match="/">
        <feed xmlns="http://www.w3.org/2005/Atom" xmlns:g="http://base.google.com/ns/1.0">
            <title>Product Feed</title>
            <link rel="self" href="https://www.ezebra.com.ua"><xsl:text> </xsl:text></link>
            
            <xsl:for-each select="/offer/products/*">
                <xsl:variable name="p_title" select="normalize-space(substring(description/name, 1, 150))"/>
                
                <!-- 1. Pomiń produkty bez nazwy w języku UA -->
                <xsl:if test="$p_title != ''">
                    <xsl:for-each select="sizes/size">
                        <xsl:variable name="size_id" select="@id"/>
                        <entry>
                            
                            <!-- ID (dla produktów wielorozmiarowych warto zmienić na pełne @code, żeby ID były unikalne) -->
                            <id><xsl:value-of select="substring-before(concat(@code, '-'), '-')"/></id>
                            
                            <!-- TITLE -->
                            <!-- <title><xsl:value-of select="$p_title"/></title> -->
						<xsl:for-each select="../..">
							<!-- 2026.04.30 MD -->
							<xsl:variable name="wybierzZrodloNazwy">
								<xsl:choose>
									<xsl:when test="iaiext:pricecomparator_name 
											and iaiext:pricecomparator_name != ''
											and ../@language = iaiext:pricecomparator_name/@xml:lang">
										<xsl:call-template name="wordFormat">
											<xsl:with-param name="text" select="substring(iaiext:pricecomparator_name[@xml:lang = ../../@language]/., 1, 146)" tunnel="yes" />
											<xsl:with-param name="cerrected" select="$corrected"  tunnel="yes"/>
										</xsl:call-template>
										<xsl:if test="string-length(iaiext:pricecomparator_name[@xml:lang = ../../@language]/.) >= 146">
											<xsl:text disable-output-escaping="yes">...</xsl:text>
										</xsl:if>
									</xsl:when>
									<xsl:otherwise>
										<xsl:call-template name="wordFormat">
											<xsl:with-param name="text" select="substring(description/name/., 1, 146)" tunnel="yes" />
											<xsl:with-param name="cerrected" select="$corrected" tunnel="yes" />
										</xsl:call-template>
										<xsl:if test="string-length(description/name/.) >= 146 and description/name/. != ''">
											<xsl:text disable-output-escaping="yes">...</xsl:text>
										</xsl:if>
									</xsl:otherwise>
								</xsl:choose>
							</xsl:variable>
							<xsl:variable name="upperCaseCount">
								<xsl:call-template name="upperCaseCount">
									<xsl:with-param name="text" select="$wybierzZrodloNazwy" />
								</xsl:call-template>
							</xsl:variable>
							<xsl:variable name="lowerCaseCount">
								<xsl:call-template name="lowerCaseCount">
									<xsl:with-param name="text" select="$wybierzZrodloNazwy" />
								</xsl:call-template>
							</xsl:variable>
							
							<xsl:variable name="nazwaTowaru">
								<xsl:choose>
									<xsl:when test="($lowerCaseCount div $upperCaseCount) &lt; 0.3">
										<!-- wszystkie litery oprócz pierwszej i producenta zamienia na małe litery -->
										<xsl:variable name="lower-text">
											<xsl:value-of select="concat(substring($wybierzZrodloNazwy, 1, 1), translate(substring(normalize-space($wybierzZrodloNazwy), 2), $upperLetters, $lowerLetters))" />
										</xsl:variable>
										<xsl:choose>
											<xsl:when test="contains($lower-text, translate(producer/@name, $upperLetters, $lowerLetters))">
												<xsl:value-of select="substring-before($lower-text, translate(producer/@name, $upperLetters, $lowerLetters))" />
												<xsl:value-of select="producer/@name" />
												<xsl:value-of select="substring-after($lower-text, translate(producer/@name, $upperLetters, $lowerLetters))" />
											</xsl:when>
											<xsl:otherwise>
												<xsl:value-of select="$lower-text" />
											</xsl:otherwise>
										</xsl:choose>
									</xsl:when>
									<xsl:otherwise>
										<xsl:value-of select="$wybierzZrodloNazwy" />
									</xsl:otherwise>
								</xsl:choose>
							</xsl:variable>
							
							<xsl:element name="title">
								<xsl:call-template name="normalize-polish-pairs">
									<xsl:with-param name="text" select="$nazwaTowaru"/>
								</xsl:call-template>
							</xsl:element>
						</xsl:for-each>

                            
                            <!-- DESCRIPTION: short_desc -> long_desc -> tytuł -->
                            <description>
                                <xsl:choose>
                                    <xsl:when test="normalize-space(../../description/short_desc) != ''">
                                        <xsl:value-of select="normalize-space(../../description/short_desc)"/>
                                    </xsl:when>
                                    <xsl:when test="normalize-space(../../description/long_desc) != ''">
                                        <xsl:value-of select="substring(normalize-space(../../description/long_desc), 1, 5000)"/>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <xsl:value-of select="$p_title"/>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </description>
                            
                            <!-- AVAILABILITY -->
                            <xsl:variable name="unit" select="../../iaiext:delivery_time/@unit"/>
                            <xsl:variable name="days" select="../../iaiext:delivery_time/@value"/>
                            <availability>
                                <xsl:choose>
                                    <xsl:when test="stock/@id &gt;= 1">in stock</xsl:when>
                                    <xsl:when test="stock/@id = 0">
                                        <xsl:choose>
                                            <xsl:when test="($unit = 'day' and $days &lt;= 3) or ($unit = 'hour' and $days &lt;= 72) or ($unit = 'minute' and $days &lt;= 4320)">in stock</xsl:when>
                                            <xsl:when test="($unit = 'day' and $days &gt; 3) or ($unit = 'hour' and $days &gt; 72) or ($unit = 'minute' and $days &gt; 4320)">available for order</xsl:when>
                                            <xsl:otherwise>out of stock</xsl:otherwise>
                                        </xsl:choose>
                                    </xsl:when>
                                    <xsl:when test="stock/@id = -2">available for order</xsl:when>
                                    <xsl:otherwise>out of stock</xsl:otherwise>
                                </xsl:choose>
                            </availability>
                            
                            <!-- CONDITION -->
                            <condition>new</condition>
                            
                            <!-- GTIN / MPN -->
                            <!-- <xsl:choose>
                                <xsl:when test="(../../@producer_code_standard = 'ISBN10' or ../../@producer_code_standard = 'ISBN13' or
                                                ../../@producer_code_standard = 'GTIN8' or ../../@producer_code_standard = 'GTIN13' or
                                                ../../@producer_code_standard = 'GTIN14' or ../../@producer_code_standard = 'GTIN12' or
                                                ../../@producer_code_standard = 'UPCE') and @code_producer != ''">
                                    <gtin><xsl:value-of select="@code_producer"/></gtin>
                                </xsl:when>
                                <xsl:when test="@code_producer != ''"><mpn><xsl:value-of select="@code_producer"/></mpn></xsl:when>
                                <xsl:when test="@iaiext:code_external != ''"><mpn><xsl:value-of select="@iaiext:code_external"/></mpn></xsl:when>
                                <xsl:when test="../../@code_on_card != ''"><mpn><xsl:value-of select="../../@code_on_card"/></mpn></xsl:when>
                                <xsl:when test="@code_on_card != ''"><mpn><xsl:value-of select="@code_on_card"/></mpn></xsl:when>
                            </xsl:choose> -->
						<xsl:choose>
							<!-- ISBN-10 / ISBN-13 -->
							<xsl:when test="(../../@producer_code_standard = 'ISBN10' or ../../@producer_code_standard = 'ISBN13') and (@code_producer and not(@code_producer=''))">
								<xsl:element name="g:gtin">
									<xsl:value-of select="@code_producer"/>
								</xsl:element>
							</xsl:when>
							<!-- MPN -->
							<xsl:when test="(../../@producer_code_standard = 'MPN') and (@code_producer and not(@code_producer=''))">
								<xsl:element name="g:mpn">
									<xsl:value-of select="@code_producer"/>
								</xsl:element>
							</xsl:when>
							<!-- GTIN-8/12/13/14, UPC-E, INNY i brak standardu: normalizacja + walidacja sumy kontrolnej GS1 -->
							<xsl:otherwise>
								<xsl:variable name="GTIN">
									<xsl:choose>
										<xsl:when test="@code_producer!=''">
											<xsl:value-of select="@code_producer" />
										</xsl:when>
										<xsl:when test="@iaiext:code_external!=''">
											<xsl:value-of select="@iaiext:code_external" />
										</xsl:when>
										<xsl:when test="../../@code_on_card!=''">
											<xsl:value-of select="../../@code_on_card" />
										</xsl:when>
										<xsl:when test="@code_on_card!=''">
											<xsl:value-of select="@code_on_card" />
										</xsl:when>
									</xsl:choose>
								</xsl:variable>
								<!-- tylko cyfry: usuwa prefiksy/sufiksy typu "de", "st", "A", "G" -->
								<xsl:variable name="GTIN-digits" select="translate($GTIN, translate($GTIN, '0123456789', ''), '')" />
								<xsl:variable name="GTIN-cutted-zeros">
									<xsl:call-template name="remove-leading-zeros">
										<xsl:with-param name="text" select="$GTIN-digits" />
									</xsl:call-template>
								</xsl:variable>
								<!-- długość docelowa: 11 cyfr = UPC-A z uciętym zerem wiodącym -> 12 -->
								<xsl:variable name="GTIN-candidate">
									<xsl:choose>
										<xsl:when test="string-length($GTIN-cutted-zeros) = 8 or
												string-length($GTIN-cutted-zeros) = 13 or
												string-length($GTIN-cutted-zeros) = 14">
											<xsl:value-of select="$GTIN-cutted-zeros"/>
										</xsl:when>
										<xsl:when test="string-length($GTIN-cutted-zeros) = 11 or
												string-length($GTIN-cutted-zeros) = 12">
											<xsl:value-of select="substring(concat('000000000000', $GTIN-cutted-zeros), string-length($GTIN-cutted-zeros) + 1)"/>
										</xsl:when>
									</xsl:choose>
								</xsl:variable>
								<xsl:variable name="GTIN-valid">
									<xsl:if test="$GTIN-candidate != ''">
										<xsl:call-template name="gtin-checksum-valid">
											<xsl:with-param name="code" select="$GTIN-candidate" />
										</xsl:call-template>
									</xsl:if>
								</xsl:variable>
								<xsl:choose>
									<xsl:when test="string-length($GTIN-cutted-zeros) = 0"/>
									<xsl:when test="$GTIN-valid = 'true'">
										<xsl:element name="gtin">
											<xsl:value-of select="$GTIN-candidate"/>
										</xsl:element>
									</xsl:when>
									<xsl:otherwise>
										<xsl:element name="mpn">
											<xsl:value-of select="$GTIN-cutted-zeros"/>
										</xsl:element>
									</xsl:otherwise>
								</xsl:choose>
							</xsl:otherwise>
						</xsl:choose>
                            
                            <!-- PRICE -->
                            <xsl:variable name="cur" select="../../@currency"/>
                            <xsl:variable name="sell" select="number(price/@gross)"/>
                            <xsl:variable name="cena_serwis">
                                <xsl:choose>
                                    <xsl:when test="../../iaiext:pricecomparator_price/iaiext:site/@gross &gt; 0">
                                        <xsl:value-of select="../../iaiext:pricecomparator_price/iaiext:site/@gross"/>
                                    </xsl:when>
                                    <xsl:otherwise>0</xsl:otherwise>
                                </xsl:choose>
                            </xsl:variable>
                            <xsl:variable name="cena_przekreslona">
                                <xsl:choose>
                                    <xsl:when test="strikethrough_retail_price/@gross &gt; 0"><xsl:value-of select="strikethrough_retail_price/@gross"/></xsl:when>
                                    <xsl:when test="../../strikethrough_retail_price/@gross &gt; 0"><xsl:value-of select="../../strikethrough_retail_price/@gross"/></xsl:when>
                                    <xsl:otherwise>0</xsl:otherwise>
                                </xsl:choose>
                            </xsl:variable>
                            <xsl:variable name="cena_przedpromocyjna">
                                <xsl:choose>
                                    <xsl:when test="../../promotion/price/normal_retail_price/iaiext:site/iaiext:price_per_size[@id = $size_id]/@gross &gt; 0">
                                        <xsl:value-of select="../../promotion/price/normal_retail_price/iaiext:site/iaiext:price_per_size[@id = $size_id]/@gross"/>
                                    </xsl:when>
                                    <xsl:when test="../../promotion/price/normal_retail_price/@gross &gt; 0">
                                        <xsl:value-of select="../../promotion/price/normal_retail_price/@gross"/>
                                    </xsl:when>
                                    <xsl:otherwise>0</xsl:otherwise>
                                </xsl:choose>
                            </xsl:variable>
                            
                            <!-- Cena aktualna = cena porównywarkowa (jeśli ustawiona), inaczej cena sklepu -->
                            <xsl:variable name="current">
                                <xsl:choose>
                                    <xsl:when test="$cena_serwis &gt; 0"><xsl:value-of select="$cena_serwis"/></xsl:when>
                                    <xsl:otherwise><xsl:value-of select="$sell"/></xsl:otherwise>
                                </xsl:choose>
                            </xsl:variable>
                            <!-- Cena regularna = najwyższa z: przedpromocyjna / przekreślona / aktualna -->
                            <xsl:variable name="regular">
                                <xsl:choose>
                                    <xsl:when test="$cena_przedpromocyjna &gt; $current and $cena_przedpromocyjna &gt;= $cena_przekreslona"><xsl:value-of select="$cena_przedpromocyjna"/></xsl:when>
                                    <xsl:when test="$cena_przekreslona &gt; $current"><xsl:value-of select="$cena_przekreslona"/></xsl:when>
                                    <xsl:otherwise><xsl:value-of select="$current"/></xsl:otherwise>
                                </xsl:choose>
                            </xsl:variable>
                            
                            <g:price><xsl:value-of select="concat($regular, ' ', $cur)"/></g:price>
                            <xsl:if test="number($regular) &gt; number($current)">
                                <g:sale_price><xsl:value-of select="concat($current, ' ', $cur)"/></g:sale_price>
                            </xsl:if>
                            
                            <!-- LINK -->
                            <link>
                                <xsl:value-of select="concat(substring-before(../../card/@url, '.feed'), '.html')"/>
                                <xsl:if test="$size_id != 'uniw'">
                                    <xsl:value-of select="concat('?selected_size=', $size_id)"/>
                                </xsl:if>
                            </link>
                            
                            <!-- IMAGE_LINK -->
                            <image_link><xsl:value-of select="../../images/large/image[1]/@url"/></image_link>
                            
                            <!-- BRAND -->
                            <xsl:if test="../../producer/@name != ''">
                                <brand><xsl:value-of select="../../producer/@name"/></brand>
                            </xsl:if>
                            
                            <!-- GOOGLE CATEGORY: kategoria sklepu z separatorem " > " -->
                            <google_product_category>
                                <xsl:choose>
                                    <xsl:when test="contains(../../category/@name, '*')">
                                        <xsl:value-of select="substring-after(../../category/@name, '*')"/>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <xsl:call-template name="cat-path">
                                            <xsl:with-param name="text" select="normalize-space(../../category/@name)"/>
                                        </xsl:call-template>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </google_product_category>
                            
                            <!-- CUSTOM_LABEL_1 - wszystkie etykiety marketingowe w kolejności priorytetu, max 100 znaków (ANALIZA_etykiety_gmc.md) -->
                            <xsl:variable name="flagi" select="../../iaiext:hotspots/iaiext:site/flag[@visible = 'yes']/@type"/>
                            <xsl:variable name="ramka" select="../../parameters/parameter[@id = '87890' or @id = '30936']/value/@id"/>
                            <xsl:variable name="etykiety">
                                <xsl:if test="$ramka = '87896'"><xsl:text>, Outlet</xsl:text></xsl:if>
                                <xsl:if test="$flagi = 'promotion'"><xsl:text>, Promocje</xsl:text></xsl:if>
                                <xsl:if test="$flagi = 'distinguished'"><xsl:text>, Nie przegap</xsl:text></xsl:if>
                                <xsl:if test="$ramka = '87891'"><xsl:text>, Hity z TikToka</xsl:text></xsl:if>
                                <xsl:if test="$ramka = '87881'"><xsl:text>, Wybór kosmetologa</xsl:text></xsl:if>
                                <xsl:if test="$flagi = 'bestseller'"><xsl:text>, Bestseller</xsl:text></xsl:if>
                                <xsl:if test="$flagi = 'newproduct'"><xsl:text>, Nowość</xsl:text></xsl:if>
                            </xsl:variable>
                            <xsl:if test="$etykiety != ''">
                                <!-- usunięcie wiodącego ", " i obcięcie do limitu 100 znaków -->
                                <custom_label_1><xsl:value-of select="substring(substring($etykiety, 3), 1, 100)"/></custom_label_1>
                            </xsl:if>
                        </entry>
                    </xsl:for-each>
                </xsl:if>
            </xsl:for-each>
        </feed>
    </xsl:template>
    
    <!-- Zamiana "A/B/C" na "A > B > C" (rekurencyjnie, dowolna liczba poziomów) -->
    <xsl:template name="cat-path">
        <xsl:param name="text"/>
        <xsl:choose>
            <xsl:when test="contains($text, '/')">
                <xsl:value-of select="normalize-space(substring-before($text, '/'))"/>
                <xsl:text> &gt; </xsl:text>
                <xsl:call-template name="cat-path">
                    <xsl:with-param name="text" select="substring-after($text, '/')"/>
                </xsl:call-template>
            </xsl:when>
            <xsl:otherwise><xsl:value-of select="normalize-space($text)"/></xsl:otherwise>
        </xsl:choose>
    </xsl:template>
	<xsl:template name="remove-leading-zeros">
		<xsl:param name="text" />
		<xsl:choose>
			<xsl:when test="starts-with($text, '0')">
				<xsl:call-template name="remove-leading-zeros">
					<xsl:with-param name="text" select="substring($text, 2)" />
				</xsl:call-template>
			</xsl:when>
			<xsl:otherwise>
				<xsl:value-of select="$text" />
			</xsl:otherwise>
		</xsl:choose>
	</xsl:template>
	<!-- Walidacja cyfry kontrolnej GS1 (EAN-8/UPC-A/EAN-13/GTIN-14): zwraca 'true' / 'false' -->
	<xsl:template name="gtin-checksum-valid">
		<xsl:param name="code" />
		<xsl:variable name="body" select="substring($code, 1, string-length($code) - 1)" />
		<xsl:variable name="sum">
			<xsl:call-template name="gtin-weighted-sum">
				<xsl:with-param name="digits" select="$body" />
				<xsl:with-param name="weight" select="3" />
			</xsl:call-template>
		</xsl:variable>
		<xsl:value-of select="(10 - ($sum mod 10)) mod 10 = number(substring($code, string-length($code)))" />
	</xsl:template>

	<!-- suma ważona od prawej: wagi 3,1,3,1... -->
	<xsl:template name="gtin-weighted-sum">
		<xsl:param name="digits" />
		<xsl:param name="weight" />
		<xsl:choose>
			<xsl:when test="$digits = ''">0</xsl:when>
			<xsl:otherwise>
				<xsl:variable name="rest">
					<xsl:call-template name="gtin-weighted-sum">
						<xsl:with-param name="digits" select="substring($digits, 1, string-length($digits) - 1)" />
						<xsl:with-param name="weight" select="4 - $weight" />
					</xsl:call-template>
				</xsl:variable>
				<xsl:value-of select="number(substring($digits, string-length($digits))) * $weight + $rest" />
			</xsl:otherwise>
		</xsl:choose>
	</xsl:template>
   
   <xsl:template name="wordFormat">
      <xsl:param name="text" />
      <xsl:param name="delimiter" select="' '" />
      <xsl:param name="correct" select="'\GRATIS\'" />

      <xsl:choose>
         <xsl:when test="contains($text, $delimiter) and not(contains(substring-before($text, $delimiter),'/'))">
            <xsl:variable name="word">
               <xsl:text><![CDATA[\]]></xsl:text>
               <xsl:value-of select="substring-before($text, $delimiter)" />
               <xsl:text><![CDATA[\]]></xsl:text>
            </xsl:variable>
            <xsl:choose>
               <xsl:when test="contains($correct, $word)">
                  <xsl:value-of select="substring(translate($word, '\', ''),1,1)" />
                  <xsl:value-of select="translate(substring(translate($word, '\', ''),2), $upperLetters, $lowerLetters)" />
                  <xsl:value-of select="$delimiter" />
                  <xsl:call-template name="wordFormat">
                     <xsl:with-param name="text" select="substring-after($text, $delimiter)" />
                  </xsl:call-template>
               </xsl:when>
               <xsl:otherwise>
                  <xsl:value-of select="translate($word, '\', '')" />
                  <xsl:value-of select="$delimiter" />
                  <xsl:call-template name="wordFormat">
                     <xsl:with-param name="text" select="substring-after($text, $delimiter)" />
                  </xsl:call-template>
               </xsl:otherwise>
            </xsl:choose>
         </xsl:when>
         <xsl:when test="contains($text, '/')">
            <xsl:variable name="word">
               <xsl:text><![CDATA[\]]></xsl:text>
               <xsl:value-of select="substring-before($text, '/')" />
               <xsl:text><![CDATA[\]]></xsl:text>
            </xsl:variable>
            <xsl:choose>
               <xsl:when test="contains($correct, $word)">
                  <xsl:value-of select="substring(translate($word, '\', ''),1,1)" />
                  <xsl:value-of select="translate(substring(translate($word, '\', ''),2), $upperLetters, $lowerLetters)" />
                  <xsl:text><![CDATA[/]]></xsl:text>
                  <xsl:call-template name="wordFormat">
                     <xsl:with-param name="text" select="substring-after($text, '/')" />
                  </xsl:call-template>
               </xsl:when>
               <xsl:otherwise>
                  <xsl:value-of select="translate($word, '\', '')" />
                  <xsl:text><![CDATA[/]]></xsl:text>
                  <xsl:call-template name="wordFormat">
                     <xsl:with-param name="text" select="substring-after($text, '/')" />
                  </xsl:call-template>
               </xsl:otherwise>
            </xsl:choose>
         </xsl:when>
         <xsl:otherwise>
            <xsl:variable name="word">
               <xsl:text><![CDATA[\]]></xsl:text>
               <xsl:value-of select="$text" />
               <xsl:text><![CDATA[\]]></xsl:text>
            </xsl:variable>
            <xsl:choose>
               <xsl:when test="contains($correct, $word)">
                  <xsl:value-of select="substring(translate($word, '\', ''),1,1)" />
                  <xsl:value-of select="translate(substring(translate($word, '\', ''),2), $upperLetters, $lowerLetters)" />
               </xsl:when>
               <xsl:otherwise>
                  <xsl:value-of select="translate($word, '\', '')" />
               </xsl:otherwise>
            </xsl:choose>
         </xsl:otherwise>
      </xsl:choose>
   </xsl:template>
   
