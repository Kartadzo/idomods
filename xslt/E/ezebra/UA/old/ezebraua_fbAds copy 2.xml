<?xml version="1.0"?>
  <xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:iaiext="http://www.iai-shop.com/developers/iof/extensions.phtml" xmlns:php="http://php.net/xsl">
  <xsl:output method="xml" version="1.0" encoding="UTF-8" indent="yes" cdata-section-elements="cat name desc a"/>
  <xsl:template match="/">
  	<feed xmlns="http://www.w3.org/2005/Atom" xmlns:g="http://base.google.com/ns/1.0">
		<title>Product Feed</title>
		<link rel="self" href="https://www.ezebra.com.ua"><xsl:text> </xsl:text></link>
		<xsl:for-each select="/offer/products/*">
            <xsl:for-each select="sizes/size">
                <entry>
                    <!-- ID -->
                    <xsl:element name="id"><xsl:value-of select="@code"/></xsl:element>

                    <!-- TITLE -->
                    <!-- <xsl:element name="title">
                        <xsl:variable name="product_name" select="substring(../../description/name/., 0,150)"/>
                        <xsl:choose>
                            <xsl:when test="../../description/name/@type = 'marketplace_site_name'">	
                                <xsl:value-of select="normalize-space($product_name)"/>
                            </xsl:when>
                            <xsl:otherwise>
                                <xsl:value-of select="normalize-space($product_name)"/>	
                            </xsl:otherwise>
                        </xsl:choose>								
                    </xsl:element> -->
						<xsl:for-each select="../..">
							<!-- 2026.04.30 MD -->
							<xsl:variable name="wybierzZrodloNazwy">
								<xsl:choose>
									<xsl:when test="iaiext:pricecomparator_name 
											and iaiext:pricecomparator_name != ''
											and ../@language = iaiext:pricecomparator_name/@xml:lang">
										<xsl:call-template name="wordFormat">
											<xsl:with-param name="text" select="substring(iaiext:pricecomparator_name[@xml:lang = ../../@language]/., 1, 146)" tunnel="yes" />
											<xsl:with-param name="cerrected" select="$corrected"  tunnel="yes"/>
										</xsl:call-template>
										<xsl:if test="string-length(iaiext:pricecomparator_name[@xml:lang = ../../@language]/.) >= 146">
											<xsl:text disable-output-escaping="yes">...</xsl:text>
										</xsl:if>
									</xsl:when>
									<xsl:otherwise>
										<xsl:call-template name="wordFormat">
											<xsl:with-param name="text" select="substring(description/name/., 1, 146)" tunnel="yes" />
											<xsl:with-param name="cerrected" select="$corrected" tunnel="yes" />
										</xsl:call-template>
										<xsl:if test="string-length(description/name/.) >= 146 and description/name/. != ''">
											<xsl:text disable-output-escaping="yes">...</xsl:text>
										</xsl:if>
									</xsl:otherwise>
								</xsl:choose>
							</xsl:variable>
							<xsl:variable name="upperCaseCount">
								<xsl:call-template name="upperCaseCount">
									<xsl:with-param name="text" select="$wybierzZrodloNazwy" />
								</xsl:call-template>
							</xsl:variable>
							<xsl:variable name="lowerCaseCount">
								<xsl:call-template name="lowerCaseCount">
									<xsl:with-param name="text" select="$wybierzZrodloNazwy" />
								</xsl:call-template>
							</xsl:variable>
							
							<xsl:variable name="nazwaTowaru">
								<xsl:choose>
									<xsl:when test="($lowerCaseCount div $upperCaseCount) &lt; 0.3">
										<!-- wszystkie litery oprócz pierwszej i producenta zamienia na małe litery -->
										<xsl:variable name="lower-text">
											<xsl:value-of select="concat(substring($wybierzZrodloNazwy, 1, 1), translate(substring(normalize-space($wybierzZrodloNazwy), 2), $upperLetters, $lowerLetters))" />
										</xsl:variable>
										<xsl:choose>
											<xsl:when test="contains($lower-text, translate(producer/@name, $upperLetters, $lowerLetters))">
												<xsl:value-of select="substring-before($lower-text, translate(producer/@name, $upperLetters, $lowerLetters))" />
												<xsl:value-of select="producer/@name" />
												<xsl:value-of select="substring-after($lower-text, translate(producer/@name, $upperLetters, $lowerLetters))" />
											</xsl:when>
											<xsl:otherwise>
												<xsl:value-of select="$lower-text" />
											</xsl:otherwise>
										</xsl:choose>
									</xsl:when>
									<xsl:otherwise>
										<xsl:value-of select="$wybierzZrodloNazwy" />
									</xsl:otherwise>
								</xsl:choose>
							</xsl:variable>
							
							<xsl:element name="title">
								<xsl:call-template name="normalize-polish-pairs">
									<xsl:with-param name="text" select="$nazwaTowaru"/>
								</xsl:call-template>
							</xsl:element>
						</xsl:for-each>

                    <!-- DESCRIPTION -->
                    <xsl:for-each select="../../description">
                        <xsl:element name="description">
                            <xsl:choose>
                                <xsl:when test="short_desc != ''">	
                                    <xsl:value-of select="short_desc/."/>
                                </xsl:when>
                                <xsl:otherwise>
                                    <xsl:value-of select="substring(long_desc/., 0,5000)"/>
                                </xsl:otherwise>
                            </xsl:choose>
                        </xsl:element>
                    </xsl:for-each>

                    <!-- AVAILABILITY -->
                    <xsl:element name="availability">
                        <xsl:variable name="unit" select="../../iaiext:delivery_time/@unit"/>
                        <xsl:variable name="days" select="../../iaiext:delivery_time/@value"/>	
                        <xsl:variable name="instock"><![CDATA[in stock]]></xsl:variable>
                        <xsl:variable name="preorder"><![CDATA[for order]]></xsl:variable>
                        <xsl:variable name="outofstock"><![CDATA[out of stock]]></xsl:variable>								
                        <xsl:choose>
                            <xsl:when test="stock/@id &gt;= 1">
                                <xsl:value-of select="$instock"/>
                            </xsl:when>
                            <xsl:when test="stock/@id = 0">
                                <xsl:choose>
                                    <xsl:when test="($unit = 'day' and $days &lt;= 3) or ($unit = 'hour' and $days &lt;= 72) or ($unit = 'minute' and $days &lt;= 4320)">
                                        <xsl:value-of select="$instock"/>
                                    </xsl:when>
                                    <xsl:when test="($unit = 'day' and $days &gt; 3) or ($unit = 'hour' and $days &gt; 72) or ($unit = 'minute' and $days &gt; 4320)">
                                        <xsl:value-of select="$preorder"/>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <xsl:value-of select="$outofstock"/>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </xsl:when>
                            <xsl:when test="stock/@id = -2">
                                <xsl:value-of select="$preorder"/>
                            </xsl:when>
                            <xsl:otherwise>
                                <xsl:value-of select="$outofstock"/>	
                            </xsl:otherwise>
                        </xsl:choose>							
                    </xsl:element>

                    <!-- CONDITION -->
                    <xsl:element name="condition"><![CDATA[new]]></xsl:element>

                    <!-- PRICE -->
                    <xsl:variable name="cena_serwis">
                        <xsl:choose>
                            <xsl:when test="../../iaiext:pricecomparator_price/iaiext:site">
                                <xsl:value-of select="../../iaiext:pricecomparator_price/iaiext:site/@gross"/>
                            </xsl:when>
                            <xsl:otherwise>
                                <xsl:text>0</xsl:text>
                            </xsl:otherwise>
                        </xsl:choose>
                    </xsl:variable>
                    <xsl:variable name="mainPrice">
                        <xsl:choose>
                            <xsl:when test="../../strikethrough_retail_price and  ../../strikethrough_retail_price/@gross > 0 and
                              ../../strikethrough_retail_price/@gross > price/@gross and 
                              price/@gross = ../../price/@gross and 
                              ../../strikethrough_retail_price/@gross > $cena_serwis">
                                <xsl:choose>
                                    <xsl:when test="../../strikethrough_retail_price/@gross > price/@gross">
                                        <xsl:value-of select="../../strikethrough_retail_price/@gross"/>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <xsl:value-of select="price/@gross"/>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </xsl:when>
                            <xsl:when test="../../iaiext:pricecomparator_price/iaiext:site and ../../price/@gross = price/@gross">
                                <xsl:choose>
                                    <xsl:when test="../../promotion/price/normal_retail_price/@gross > ../../iaiext:pricecomparator_price/iaiext:site/@gross">
                                        <xsl:value-of select="../../promotion/price/normal_retail_price/@gross"/>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <xsl:value-of select="../../iaiext:pricecomparator_price/iaiext:site/@gross"/>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </xsl:when>
                            <xsl:when test="price/@gross">
                                <xsl:choose>
                                    <xsl:when test="price/@gross != ../../price/@gross and
                                    ../../promotion/price/normal_retail_price/iaiext:site/iaiext:price_per_size[@id = ../../../../../sizes/size/@id]/@gross > price/@gross">
                                        <xsl:value-of select="../../promotion/price/normal_retail_price/iaiext:site/iaiext:price_per_size[@id = ../../../../../sizes/size/@id]/@gross"/>
                                    </xsl:when>
                                    <xsl:when test="price/@gross = ../../price/@gross and
                                    ../../promotion/price/normal_retail_price/@gross > price/@gross">
                                        <xsl:value-of select="../../promotion/price/normal_retail_price/@gross"/>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <xsl:value-of select="price/@gross"/>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </xsl:when>
                        </xsl:choose>
                    </xsl:variable>
                    <price>
                        <xsl:value-of select="$mainPrice"/>
                        <xsl:text><![CDATA[ ]]></xsl:text>
                        <xsl:value-of select="../../@currency"/>
                    </price>
                    <!-- produkcja -->
                    <!-- jesli bedzie promocja lub przekreślona cena to od razu promocyjna cene większa od normalnej-->
                    <xsl:if test="../../promotion/price/normal_retail_price or ../../strikethrough_retail_price">
                        <xsl:choose>        <!-- (../../srp and ../../srp/@gross > price/@gross) or -->
                            <xsl:when test = "
                              (../../strikethrough_retail_price and ../../strikethrough_retail_price/@gross > price/@gross) or
                              (../../promotion/price/normal_retail_price and ../../promotion/price/normal_retail_price/@gross > price/@gross) or
                              (../../promotion/price/normal_retail_price and ../../price/@gross != price/@gross and 
                              ../../promotion/price/normal_retail_price/iaiext:site/iaiext:price_per_size[@id = ../../../../../sizes/size/@id]/@gross > price/@gross)">
                                <sale_price>
                                    <xsl:value-of select="price/@gross"/>
                                    <xsl:text><![CDATA[ ]]></xsl:text>
                                    <xsl:value-of select="../../@currency"/>
                                </sale_price>
                            </xsl:when>
                        </xsl:choose>
                    </xsl:if>            
                    
                    <!-- LINK -->
                    <xsl:variable name="urlProduct" select="concat(substring-before(../../card/@url, '.feed'),'.html')"/>
                    <xsl:variable name="sizeID" select="@id"/>
                    <xsl:element name="link">
                        <xsl:value-of select="$urlProduct"/><xsl:if test="$sizeID != 'uniw'">?selected_size=<xsl:value-of select="$sizeID"/></xsl:if>
                    </xsl:element>
                    
                    <!-- IMAGE_LINK -->
                    <xsl:element name="image_link">
                        <xsl:value-of select="../../images/large/image[1]/@url"/>
                    </xsl:element>

                    <!-- BRAND -->
                    <xsl:if test="../../producer/@name">
                        <xsl:element name="brand">
                            <xsl:value-of select="../../producer/@name"/>
                        </xsl:element>
                    </xsl:if>

                    <!-- GOOGLE CATEGORY -->
                    <xsl:element name="google_product_category">
                        <xsl:choose>
                            <xsl:when test="contains(../../category/@name, '*')">
                                <xsl:value-of select="substring-after(../../category/@name, '*')"/>
                            </xsl:when>
                            <xsl:otherwise>
                                <xsl:variable name="kier2"><![CDATA[ > ]]></xsl:variable>
                                <xsl:variable name="category" select="normalize-space(../../category/@name)"/>
                                <xsl:variable name="cat1" select="substring-before($category, '/')"/>
                                <xsl:variable name="cat11" select="substring-after($category, '/')"/>
                                <xsl:variable name="cat2" select="substring-before($cat11, '/')"/>
                                <xsl:variable name="cat22" select="substring-after($cat11, '/')"/>
                                <xsl:variable name="cat3" select="substring-before($cat22, '/')"/>
                                <xsl:variable name="cat33" select="substring-after($cat22, '/')"/>
                                <xsl:variable name="cat4" select="substring-before($cat33, '/')"/>
                                <xsl:variable name="cat44" select="substring-after($cat33, '/')"/>
                                <xsl:variable name="cat5" select="substring-before($cat44, '/')"/>
                                <xsl:variable name="cat55" select="substring-after($cat44, '/')"/>
                                <xsl:variable name="cat6" select="substring-before($cat55, '/')"/>
                                <xsl:variable name="cat66" select="substring-after($cat55, '/')"/>
                                <xsl:variable name="cat7" select="substring-before($cat66, '/')"/>
                                <xsl:variable name="cat77" select="substring-after($cat66, '/')"/>
                                <xsl:variable name="cat8" select="substring-before($cat77, '/')"/>
                                <!-- poziom 1 -->
                                <xsl:if test="$cat1=''"><xsl:value-of select="$category"/></xsl:if>
                                <xsl:if test="$cat1 !=''"><xsl:value-of select="$cat1"/></xsl:if>
                                <!-- poziom 2 -->
                                <xsl:if test="($cat11 !='' or $cat2 !='')"><xsl:value-of select="$kier2"/></xsl:if>
                                <xsl:if test="$cat2 !=''"><xsl:value-of select="$cat2"/></xsl:if>
                                <xsl:if test="$cat11 !='' and $cat2=''"><xsl:value-of select="$cat11"/></xsl:if>
                                <!-- poziom 3 -->
                                <xsl:if test="($cat22 !='' or $cat3 !='')"><xsl:value-of select="$kier2"/></xsl:if>
                                <xsl:if test="$cat3 !=''"><xsl:value-of select="$cat3"/></xsl:if>
                                <xsl:if test="$cat22 !='' and $cat3=''"><xsl:value-of select="$cat22"/></xsl:if>
                                <!-- poziom 4 -->
                                <xsl:if test="($cat33 !='' or $cat4 !='')"><xsl:value-of select="$kier2"/></xsl:if>
                                <xsl:if test="$cat4 !=''"><xsl:value-of select="$cat4"/></xsl:if>
                                <xsl:if test="$cat33 !='' and $cat4=''"><xsl:value-of select="$cat33"/></xsl:if>
                                <!-- poziom 5 -->
                                <xsl:if test="($cat44 !='' or $cat5 !='')"><xsl:value-of select="$kier2"/></xsl:if>
                                <xsl:if test="$cat5 !=''"><xsl:value-of select="$cat5"/></xsl:if>
                                <xsl:if test="$cat44 !='' and $cat5=''"><xsl:value-of select="$cat44"/></xsl:if>
                                <!-- poziom 6 -->
                                <xsl:if test="($cat55 !='' or $cat6 !='')"><xsl:value-of select="$kier2"/></xsl:if>
                                <xsl:if test="$cat6 !=''"><xsl:value-of select="$cat6"/></xsl:if>
                                <xsl:if test="$cat55 !='' and $cat6=''"><xsl:value-of select="$cat55"/></xsl:if>
                                <!-- poziom 7 -->
                                <xsl:if test="($cat66 !='' or $cat7 !='')"><xsl:value-of select="$kier2"/></xsl:if>
                                <xsl:if test="$cat7 !=''"><xsl:value-of select="$cat7"/></xsl:if>
                                <xsl:if test="$cat66 !='' and $cat7=''"><xsl:value-of select="$cat66"/></xsl:if>
                                <!-- poziom 8 -->
                                <xsl:if test="($cat77 !='' or $cat8 !='')"><xsl:value-of select="$kier2"/></xsl:if>
                                <xsl:if test="$cat8 !=''"><xsl:value-of select="$cat8"/></xsl:if>
                                <xsl:if test="$cat77 !='' and $cat8=''"><xsl:value-of select="$cat77"/></xsl:if>
                            </xsl:otherwise>
                        </xsl:choose>
                    </xsl:element>
						
						<!-- Gtin / MPN -->
						<xsl:choose>
							<!-- ISBN-10 / ISBN-13 -->
							<xsl:when test="(../../@producer_code_standard = 'ISBN10' or ../../@producer_code_standard = 'ISBN13') and (@code_producer and not(@code_producer=''))">
								<xsl:element name="g:gtin">
									<xsl:value-of select="@code_producer"/>
								</xsl:element>
							</xsl:when>
							<!-- MPN -->
							<xsl:when test="(../../@producer_code_standard = 'MPN') and (@code_producer and not(@code_producer=''))">
								<xsl:element name="g:mpn">
									<xsl:value-of select="@code_producer"/>
								</xsl:element>
							</xsl:when>
							<!-- GTIN-8/12/13/14, UPC-E, INNY i brak standardu: normalizacja + walidacja sumy kontrolnej GS1 -->
							<xsl:otherwise>
								<xsl:variable name="GTIN">
									<xsl:choose>
										<xsl:when test="@code_producer!=''">
											<xsl:value-of select="@code_producer" />
										</xsl:when>
										<xsl:when test="@iaiext:code_external!=''">
											<xsl:value-of select="@iaiext:code_external" />
										</xsl:when>
										<xsl:when test="../../@code_on_card!=''">
											<xsl:value-of select="../../@code_on_card" />
										</xsl:when>
										<xsl:when test="@code_on_card!=''">
											<xsl:value-of select="@code_on_card" />
										</xsl:when>
									</xsl:choose>
								</xsl:variable>
								<!-- tylko cyfry: usuwa prefiksy/sufiksy typu "de", "st", "A", "G" -->
								<xsl:variable name="GTIN-digits" select="translate($GTIN, translate($GTIN, '0123456789', ''), '')" />
								<xsl:variable name="GTIN-cutted-zeros">
									<xsl:call-template name="remove-leading-zeros">
										<xsl:with-param name="text" select="$GTIN-digits" />
									</xsl:call-template>
								</xsl:variable>
								<!-- długość docelowa: 11 cyfr = UPC-A z uciętym zerem wiodącym -> 12 -->
								<xsl:variable name="GTIN-candidate">
									<xsl:choose>
										<xsl:when test="string-length($GTIN-cutted-zeros) = 8 or
												string-length($GTIN-cutted-zeros) = 13 or
												string-length($GTIN-cutted-zeros) = 14">
											<xsl:value-of select="$GTIN-cutted-zeros"/>
										</xsl:when>
										<xsl:when test="string-length($GTIN-cutted-zeros) = 11 or
												string-length($GTIN-cutted-zeros) = 12">
											<xsl:value-of select="substring(concat('000000000000', $GTIN-cutted-zeros), string-length($GTIN-cutted-zeros) + 1)"/>
										</xsl:when>
									</xsl:choose>
								</xsl:variable>
								<xsl:variable name="GTIN-valid">
									<xsl:if test="$GTIN-candidate != ''">
										<xsl:call-template name="gtin-checksum-valid">
											<xsl:with-param name="code" select="$GTIN-candidate" />
										</xsl:call-template>
									</xsl:if>
								</xsl:variable>
								<xsl:choose>
									<xsl:when test="string-length($GTIN-cutted-zeros) = 0"/>
									<xsl:when test="$GTIN-valid = 'true'">
										<xsl:element name="gtin">
											<xsl:value-of select="$GTIN-candidate"/>
										</xsl:element>
									</xsl:when>
									<xsl:otherwise>
										<xsl:element name="mpn">
											<xsl:value-of select="$GTIN-cutted-zeros"/>
										</xsl:element>
									</xsl:otherwise>
								</xsl:choose>
							</xsl:otherwise>
						</xsl:choose>
                </entry>
            </xsl:for-each>
		</xsl:for-each>
	</feed>
  </xsl:template>
  <xsl:template name="string-replace-all">
        <xsl:param name="text" />
        <xsl:param name="replace" />
        <xsl:param name="by" />
        <xsl:param name="depth" select="0" />
        <xsl:choose>
            <xsl:when test="contains($text, $replace) and $depth &lt; 1000">
                <xsl:value-of select="substring-before($text,$replace)" />
                <xsl:value-of select="$by" />
                <xsl:call-template name="string-replace-all">
                    <xsl:with-param name="text" select="substring-after($text,$replace)" />
                    <xsl:with-param name="replace" select="$replace" />
                    <xsl:with-param name="by" select="$by" />
                    <xsl:with-param name="depth" select="$depth + 1" />
                </xsl:call-template>
            </xsl:when>
            <xsl:otherwise>
                <xsl:value-of select="$text" />
            </xsl:otherwise>
        </xsl:choose>
  </xsl:template>
	
	<xsl:template name="remove-leading-zeros">
		<xsl:param name="text" />
		<xsl:choose>
			<xsl:when test="starts-with($text, '0')">
				<xsl:call-template name="remove-leading-zeros">
					<xsl:with-param name="text" select="substring($text, 2)" />
				</xsl:call-template>
			</xsl:when>
			<xsl:otherwise>
				<xsl:value-of select="$text" />
			</xsl:otherwise>
		</xsl:choose>
	</xsl:template>
	<!-- Walidacja cyfry kontrolnej GS1 (EAN-8/UPC-A/EAN-13/GTIN-14): zwraca 'true' / 'false' -->
	<xsl:template name="gtin-checksum-valid">
		<xsl:param name="code" />
		<xsl:variable name="body" select="substring($code, 1, string-length($code) - 1)" />
		<xsl:variable name="sum">
			<xsl:call-template name="gtin-weighted-sum">
				<xsl:with-param name="digits" select="$body" />
				<xsl:with-param name="weight" select="3" />
			</xsl:call-template>
		</xsl:variable>
		<xsl:value-of select="(10 - ($sum mod 10)) mod 10 = number(substring($code, string-length($code)))" />
	</xsl:template>

	<!-- suma ważona od prawej: wagi 3,1,3,1... -->
	<xsl:template name="gtin-weighted-sum">
		<xsl:param name="digits" />
		<xsl:param name="weight" />
		<xsl:choose>
			<xsl:when test="$digits = ''">0</xsl:when>
			<xsl:otherwise>
				<xsl:variable name="rest">
					<xsl:call-template name="gtin-weighted-sum">
						<xsl:with-param name="digits" select="substring($digits, 1, string-length($digits) - 1)" />
						<xsl:with-param name="weight" select="4 - $weight" />
					</xsl:call-template>
				</xsl:variable>
				<xsl:value-of select="number(substring($digits, string-length($digits))) * $weight + $rest" />
			</xsl:otherwise>
		</xsl:choose>
	</xsl:template>
   
   <xsl:template name="wordFormat">
      <xsl:param name="text" />
      <xsl:param name="delimiter" select="' '" />
      <xsl:param name="correct" select="'\GRATIS\'" />

      <xsl:choose>
         <xsl:when test="contains($text, $delimiter) and not(contains(substring-before($text, $delimiter),'/'))">
            <xsl:variable name="word">
               <xsl:text><![CDATA[\]]></xsl:text>
               <xsl:value-of select="substring-before($text, $delimiter)" />
               <xsl:text><![CDATA[\]]></xsl:text>
            </xsl:variable>
            <xsl:choose>
               <xsl:when test="contains($correct, $word)">
                  <xsl:value-of select="substring(translate($word, '\', ''),1,1)" />
                  <xsl:value-of select="translate(substring(translate($word, '\', ''),2), $upperLetters, $lowerLetters)" />
                  <xsl:value-of select="$delimiter" />
                  <xsl:call-template name="wordFormat">
                     <xsl:with-param name="text" select="substring-after($text, $delimiter)" />
                  </xsl:call-template>
               </xsl:when>
               <xsl:otherwise>
                  <xsl:value-of select="translate($word, '\', '')" />
                  <xsl:value-of select="$delimiter" />
                  <xsl:call-template name="wordFormat">
                     <xsl:with-param name="text" select="substring-after($text, $delimiter)" />
                  </xsl:call-template>
               </xsl:otherwise>
            </xsl:choose>
         </xsl:when>
         <xsl:when test="contains($text, '/')">
            <xsl:variable name="word">
               <xsl:text><![CDATA[\]]></xsl:text>
               <xsl:value-of select="substring-before($text, '/')" />
               <xsl:text><![CDATA[\]]></xsl:text>
            </xsl:variable>
            <xsl:choose>
               <xsl:when test="contains($correct, $word)">
                  <xsl:value-of select="substring(translate($word, '\', ''),1,1)" />
                  <xsl:value-of select="translate(substring(translate($word, '\', ''),2), $upperLetters, $lowerLetters)" />
                  <xsl:text><![CDATA[/]]></xsl:text>
                  <xsl:call-template name="wordFormat">
                     <xsl:with-param name="text" select="substring-after($text, '/')" />
                  </xsl:call-template>
               </xsl:when>
               <xsl:otherwise>
                  <xsl:value-of select="translate($word, '\', '')" />
                  <xsl:text><![CDATA[/]]></xsl:text>
                  <xsl:call-template name="wordFormat">
                     <xsl:with-param name="text" select="substring-after($text, '/')" />
                  </xsl:call-template>
               </xsl:otherwise>
            </xsl:choose>
         </xsl:when>
         <xsl:otherwise>
            <xsl:variable name="word">
               <xsl:text><![CDATA[\]]></xsl:text>
               <xsl:value-of select="$text" />
               <xsl:text><![CDATA[\]]></xsl:text>
            </xsl:variable>
            <xsl:choose>
               <xsl:when test="contains($correct, $word)">
                  <xsl:value-of select="substring(translate($word, '\', ''),1,1)" />
                  <xsl:value-of select="translate(substring(translate($word, '\', ''),2), $upperLetters, $lowerLetters)" />
               </xsl:when>
               <xsl:otherwise>
                  <xsl:value-of select="translate($word, '\', '')" />
               </xsl:otherwise>
            </xsl:choose>
         </xsl:otherwise>
      </xsl:choose>
   </xsl:template>
   
   <!-- 03.07.2025 MD -->
   <xsl:template name="upperCaseCount"> 
      <xsl:param name="text"/> 
      <xsl:variable name="uppercaseOnly" select="translate($text, concat($lowerLetters,'0123456789., *%&amp;;\/-+()'), '')"/> 
      <xsl:value-of select="string-length($uppercaseOnly)"/> 
   </xsl:template> 
   <xsl:template name="lowerCaseCount"> 
      <xsl:param name="text"/> 
      <xsl:variable name="lowercaseOnly" select="translate($text, concat($upperLetters,'0123456789., *%&amp;;\/-+()'), '')"/> 
      <xsl:value-of select="string-length($lowercaseOnly)"/> 
   </xsl:template> 	
	
	<!-- 2026.06.18 MD -->
	<xsl:template name="normalize-polish-pairs">
		<xsl:param name="text"/>
		
		<xsl:variable name="hasPair">
			<xsl:call-template name="has-polish-pair">
				<xsl:with-param name="tmp" select="$text"/>
			</xsl:call-template>
		</xsl:variable>
		
		<xsl:choose>
			<xsl:when test="$hasPair = 'true'">
				<xsl:value-of select="translate($text, 'ĄĆĘŁŃÓŚŹŻ', 'ACELNOSZZ')"/>
			</xsl:when>
			<xsl:otherwise>
				<xsl:value-of select="$text"/>
			</xsl:otherwise>
		</xsl:choose>
	</xsl:template>
	
	<xsl:template name="has-polish-pair">
		<xsl:param name="tmp"/>
		
		<xsl:variable name="pl" select="'ĄĆĘŁŃÓŚŹŻ'"/>
		
		<xsl:choose>
			<xsl:when test="string-length($tmp) &lt; 2">
				<xsl:text>false</xsl:text>
			</xsl:when>
			<xsl:when test="
					contains($pl, substring($tmp,1,1))
					and contains($pl, substring($tmp,2,1))
					">
				<xsl:text>true</xsl:text>
			</xsl:when>
			<xsl:otherwise>
				<xsl:call-template name="has-polish-pair">
					<xsl:with-param name="tmp" select="substring($tmp,2)"/>
				</xsl:call-template>
			</xsl:otherwise>
		</xsl:choose>
	</xsl:template>
</xsl:stylesheet>