            <xsl:with-param name="by" select="'“'"/>
         </xsl:call-template>
      </xsl:variable>
      <xsl:variable name="step22">
         <xsl:call-template name="string-replace-all">
            <xsl:with-param name="text" select="$step21"/>
            <xsl:with-param name="replace" select="'&amp;rdquo;'"/>
            <xsl:with-param name="by" select="'”'"/>
         </xsl:call-template>
