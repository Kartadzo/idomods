            <xsl:with-param name="replace" select="'&amp;bdquo;'"/>
            <xsl:with-param name="by" select="'„'"/>
         </xsl:call-template>
      </xsl:variable>
      
      <xsl:value-of select="$step27"/>
   </xsl:template>   
</xsl:stylesheet>