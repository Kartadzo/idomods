            <xsl:with-param name="replace" select="'&amp;lsquo;'"/>
            <xsl:with-param name="by" select="'‘'"/>
         </xsl:call-template>
      </xsl:variable>
      <xsl:variable name="step24">
         <xsl:call-template name="string-replace-all">
            <xsl:with-param name="text" select="$step23"/>
            <xsl:with-param name="replace" select="'&amp;rsquo;'"/>
            <xsl:with-param name="by" select="'’'"/>
         </xsl:call-template>
      </xsl:variable>
      <xsl:variable name="step25">
         <xsl:call-template name="string-replace-all">
