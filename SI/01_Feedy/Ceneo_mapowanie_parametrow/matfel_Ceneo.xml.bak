<xsl:stylesheet version="1.0"
    xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
    xmlns:iaiext="http://www.iai-shop.com/developers/iof/extensions.phtml"
    xmlns:php="http://php.net/xsl">
    <xsl:output method="xml" version="1.0" encoding="UTF-8" indent="yes" cdata-section-elements="cat name a"></xsl:output>
    <xsl:template match="/">
        <offers version="1"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <xsl:for-each select="/offer/products/product">

                <xsl:variable name="lowercase" select="'abcdefghijklmnopqrstuvwxyząćęłńóśżź'" />
                <xsl:variable name="uppercase" select="'ABCDEFGHIJKLMNOPQRSTUVWXYZĄĆĘŁŃÓŚŻŹ'" />
            
            <!-- długość opisu -->
            <xsl:variable name='dlugosc_opisu'>900</xsl:variable>
            <xsl:variable name='dlugosc_opisu_z_parametrow'>600</xsl:variable>
            <xsl:variable name='zignoruj_dlugi_opis_jesli_krotki_przekracza'>600</xsl:variable>
            <!-- wymagany limit długości opisu po którego przekroczeniu nie zostanie dodany opis z parametrów  -->
            <xsl:variable name='minimalna_dlugosc_opisu_dla_parametrow'>120</xsl:variable>

                <xsl:variable name="stocksGobalCheck">
                    <xsl:for-each select="sizes/size/stock">
                        <xsl:choose>
                            <xsl:when test="@available_stock_quantity &gt; 0">
                                <xsl:value-of select="@available_stock_quantity"></xsl:value-of>
                                <xsl:text>/</xsl:text>
                            </xsl:when>
                            <xsl:when test="@available_stock_quantity = -1 ">
                                <xsl:value-of select="@available_stock_quantity"></xsl:value-of>
                                <xsl:text>/</xsl:text>
                            </xsl:when>
                        </xsl:choose>
                    </xsl:for-each>
                </xsl:variable>

                <xsl:choose>
                    <xsl:when test="@type = 'virtual' and sizes/size[1]/@available != 'unavailable' and sizes/size[1]/@available != ''">
                        <o>
                            <!-- <xsl:attribute name="basket">0</xsl:attribute> -->
                            <!-- <xsl:for-each select="parameters/parameter">
                              <xsl:choose>
                                  <xsl:when test="@name = 'Ceneo kup teraz'">
                                      <xsl:choose>
                                          <xsl:when test="value/@name = '1'">
                                          <xsl:attribute name="basket">1</xsl:attribute>
                                            </xsl:when>
                                            <xsl:otherwise>
                                                <xsl:attribute name="basket">0</xsl:attribute>
                                            </xsl:otherwise>
                                      </xsl:choose>
                                  </xsl:when>
                              </xsl:choose>
                            </xsl:for-each> -->
                            <xsl:attribute name="id">
                                <xsl:value-of select="@id"/>
                            </xsl:attribute>
                            <xsl:attribute name="url">
                                <xsl:value-of select="card/@url"/></xsl:attribute>
                            <xsl:attribute name="price">
                                <xsl:choose>
                                    <xsl:when test="iaiext:pricecomparator_price/iaiext:site/@gross">
                                        <xsl:value-of select="iaiext:pricecomparator_price/iaiext:site/@gross"/>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <xsl:value-of select="price/@gross"/>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </xsl:attribute>
                            <!-- Jeśli towar wirtualny to zawsze dostępnosć = 1 -->
                            <xsl:attribute name="avail">1</xsl:attribute>
                            <xsl:attribute name="set">
                                <xsl:choose>
                                    <xsl:when test="bundled">1</xsl:when>
                                    <xsl:otherwise>0</xsl:otherwise>
                                </xsl:choose>
                            </xsl:attribute>
                            <xsl:if test="sizes/size[1]/@weight div 1000 > 0">
                                <xsl:attribute name="weight">
                                    <xsl:value-of select="sizes/size[1]/@weight div 1000"/>
                                </xsl:attribute>
                            </xsl:if>
                            <cat>
                                <xsl:choose>
                                    <xsl:when test="category/@name = '*Kategoria tymczasowa'">
                                        <xsl:value-of select="translate(iaiext:navigation/iaiext:site/iaiext:menu[@id=1]/iaiext:item/@textid,'\','/')"></xsl:value-of>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <xsl:value-of select="translate(category/@name, '&gt;', '/')"/>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </cat>
                            <name>
                                <xsl:value-of select="description/name"/>
                            </name>
                            <imgs>
                                <xsl:variable name="vLowest">
                                    <xsl:for-each select="images/large/image/@iaiext:priority">
                                        <xsl:sort data-type="number"/>
                                        <xsl:if test="position()=1">
                                            <xsl:value-of select="."/>
                                        </xsl:if>
                                    </xsl:for-each>
                                </xsl:variable>
                                <xsl:for-each select="images/large/image">
                                    <xsl:choose>
                                        <xsl:when test="@iaiext:priority = number($vLowest)">
                                            <main>
                                                <xsl:attribute name="url">
                                                    <xsl:value-of select="@url"></xsl:value-of>
                                                </xsl:attribute>
                                            </main>
                                        </xsl:when>
                                        <xsl:otherwise>
                                            <i>
                                                <xsl:attribute name="url">
                                                    <xsl:value-of select="@url"></xsl:value-of>
                                                </xsl:attribute>
                                            </i>
                                        </xsl:otherwise>
                                    </xsl:choose>
                                </xsl:for-each>
                                <xsl:if test="images/large/image[2]/@url != ''">
                                </xsl:if>
                            </imgs>
                            <desc>
                        <!-- Opis -->
                        <!-- 2026.07.08 MD -->
                        <xsl:variable name="from_parameters_raw">
                           <xsl:for-each select="parameters/parameter[@hide = 'n' and value/@name != '']">
                              <xsl:text>&#xa;</xsl:text>
                              <xsl:value-of select="@name" />
                              <xsl:text>: </xsl:text>
                              <xsl:for-each select="value">
                                 <xsl:value-of select="@name" />
                                 <xsl:text>; </xsl:text>
                              </xsl:for-each>
                           </xsl:for-each>
                        </xsl:variable>
                        <xsl:variable name="from_parameters">
                           <xsl:choose>
                              <xsl:when test="$from_parameters_raw != ''">
                                 <xsl:call-template name="tokenize">
                                    <xsl:with-param name="text" select="substring($from_parameters_raw, 1, $dlugosc_opisu_z_parametrow)" />
                                    <xsl:with-param name="delimiter" select="';'" />
                                 </xsl:call-template>
                              </xsl:when>
                              <xsl:otherwise>
                                 <xsl:text></xsl:text>
                              </xsl:otherwise>
                           </xsl:choose>
                        </xsl:variable>
                           <xsl:choose>
                              <xsl:when test="description/short_desc = '' and description/long_desc = ''">
                                 <!-- nie jest git bo nie ma opisów  -->
                                 <xsl:if test="$from_parameters != ''">
                                    <xsl:value-of select="description/name" />
                                    <xsl:value-of select="$from_parameters" />
                                 </xsl:if>
                              </xsl:when>
                              <xsl:when test="description/short_desc = '' and string-length(normalize-space(description/long_desc)) > 0">
                                 <xsl:variable name = "opis_znormalilzowany">
                                    <xsl:call-template name="string-normalize-all">
                                       <xsl:with-param name="text" select="description/long_desc" tunnel="yes"/>
                                    </xsl:call-template>
                                 </xsl:variable>
                                 
                                 <xsl:variable name = "opis_bez_twardych_spacji">
                                    <xsl:call-template name="string-replace-all">
                                       <xsl:with-param name="text" select="$opis_znormalilzowany" tunnel="yes"/>
                                       <xsl:with-param name="replace" select="'&amp;nbsp;'" tunnel="yes"/>
                                       <xsl:with-param name="by" select="' '" tunnel="yes"/>
                                    </xsl:call-template>
                                 </xsl:variable>
                                 <xsl:variable name = "opis_bez_komentarzy">
                                    <xsl:call-template name="strip-tags">
                                       <xsl:with-param name="text" select="$opis_bez_twardych_spacji" />
                                       <xsl:with-param name="open" select="'&lt;!--'" />
                                       <xsl:with-param name="close" select="'--&gt;'" />
                                    </xsl:call-template>
                                 </xsl:variable>
                                 <xsl:variable name = "opis_bez_styli">
                                    <xsl:call-template name="strip-tags">
                                       <xsl:with-param name="text" select="$opis_bez_komentarzy" />
                                       <xsl:with-param name="open" select="'&lt;style'" />
                                       <xsl:with-param name="close" select="'&lt;/style&gt;'" />
                                    </xsl:call-template>
                                 </xsl:variable>
                                 <xsl:variable name = "opis_bez_zdjęć">
                                    <xsl:call-template name="strip-tags">
                                       <xsl:with-param name="text" select="$opis_bez_styli" />
                                       <xsl:with-param name="open" select="'&lt;img'" />
                                       <xsl:with-param name="close" select="'&quot;/&gt;'" />
                                    </xsl:call-template>
                                 </xsl:variable>
                                 <xsl:variable name = "opis_bez_tagow">
                                    <xsl:call-template name="strip-tags">
                                       <xsl:with-param name="text" select="$opis_bez_zdjęć" tunnel="yes"/>
                                    </xsl:call-template>
                                 </xsl:variable>
                                 <xsl:variable name="opis_do_kropki">
                                    <xsl:call-template name="tokenize">
                                       <xsl:with-param name="text" select="substring(normalize-space($opis_bez_tagow),1,$dlugosc_opisu)" />
                                    </xsl:call-template>
                                 </xsl:variable>
                                 <xsl:choose>
                                    <xsl:when test="$opis_do_kropki = ''">
                                       <!-- Nie ma przed kropka nic wiec podajemy co mamy bo mozliwe ze wgl nie
                                            ma kropki lool-->
                                       <xsl:text disable-output-escaping="yes">&lt;![CDATA[</xsl:text>
                                       <xsl:value-of select="normalize-space($opis_bez_tagow)" />
                                       <xsl:if test="string-length(normalize-space($opis_bez_tagow)) &lt; $minimalna_dlugosc_opisu_dla_parametrow and $from_parameters != ''">
                                          <xsl:text>&#xa;</xsl:text>
                                          <xsl:value-of select="description/name" />
                                          <xsl:value-of select="$from_parameters" />
                                       </xsl:if>
                                       <xsl:text disable-output-escaping="yes">]]&gt;</xsl:text>
                                    </xsl:when>
                                    <xsl:otherwise>
                                       <xsl:text disable-output-escaping="yes">&lt;![CDATA[</xsl:text>
                                       <xsl:value-of select="normalize-space($opis_do_kropki)" />
                                       <xsl:if test="string-length(normalize-space($opis_do_kropki)) &lt; $minimalna_dlugosc_opisu_dla_parametrow and $from_parameters != ''">
                                          <xsl:text>&#xa;</xsl:text>
                                          <xsl:value-of select="description/name" />
                                          <xsl:value-of select="$from_parameters" />
                                       </xsl:if>
                                       <xsl:text disable-output-escaping="yes">]]&gt;</xsl:text>
                                    </xsl:otherwise>
                                 </xsl:choose>
                              </xsl:when>
                              <xsl:otherwise>
                                 <!-- tutaj jeśli opis nie bedzie mial X znakow to zastapic go długim opisem mimo
                                      wszystko -->
                                 <!-- załóżmy -->
                                 <xsl:choose>
                                    <xsl:when test="string-length(description/short_desc) > $zignoruj_dlugi_opis_jesli_krotki_przekracza or description/long_desc = ''">
                                       <xsl:text disable-output-escaping="yes">&lt;![CDATA[</xsl:text>
                                       <xsl:value-of select="description/short_desc" />
                                       <xsl:if test="string-length(description/short_desc) &lt; $minimalna_dlugosc_opisu_dla_parametrow and $from_parameters != ''">
                                          <xsl:text>&#xa;</xsl:text>
                                          <xsl:value-of select="description/name" />
                                          <xsl:value-of select="$from_parameters" />
                                       </xsl:if>
                                       <xsl:text disable-output-escaping="yes">]]&gt;</xsl:text>
                                    </xsl:when>
                                    <xsl:otherwise>
                                       <xsl:variable name = "opis_znormalilzowany">
                                          <xsl:call-template name="string-normalize-all">
                                             <xsl:with-param name="text" select="description/long_desc" tunnel="yes"/>
                                          </xsl:call-template>
                                       </xsl:variable>
                                       
                                       <xsl:variable name = "opis_bez_twardych_spacji">
                                          <xsl:call-template name="string-replace-all">
                                             <xsl:with-param name="text" select="$opis_znormalilzowany" tunnel="yes"/>
                                             <xsl:with-param name="replace" select="'&amp;nbsp;'" tunnel="yes"/>
                                             <xsl:with-param name="by" select="' '" tunnel="yes"/>
                                          </xsl:call-template>
                                       </xsl:variable>
                                       <xsl:variable name = "opis_bez_komentarzy">
                                          <xsl:call-template name="strip-tags">
                                             <xsl:with-param name="text" select="$opis_bez_twardych_spacji" />
                                             <xsl:with-param name="open" select="'&lt;!--'" />
                                             <xsl:with-param name="close" select="'--&gt;'" />
                                          </xsl:call-template>
                                       </xsl:variable>
                                       <xsl:variable name = "opis_bez_styli">
                                          <xsl:call-template name="strip-tags">
                                             <xsl:with-param name="text" select="$opis_bez_komentarzy" />
                                             <xsl:with-param name="open" select="'&lt;style'" />
                                             <xsl:with-param name="close" select="'&lt;/style&gt;'" />
                                          </xsl:call-template>
                                       </xsl:variable>
                                       <xsl:variable name = "opis_bez_zdjęć">
                                          <xsl:call-template name="strip-tags">
                                             <xsl:with-param name="text" select="$opis_bez_styli" />
                                             <xsl:with-param name="open" select="'&lt;img'" />
                                             <xsl:with-param name="close" select="'&quot;/&gt;'" />
                                          </xsl:call-template>
                                       </xsl:variable>
                                       <xsl:variable name = "opis_bez_tagow">
                                          <xsl:call-template name="strip-tags">
                                             <xsl:with-param name="text" select="$opis_bez_zdjęć" tunnel="yes"/>
                                          </xsl:call-template>
                                       </xsl:variable>
                                       <xsl:variable name="opis_do_kropki">
                                          <xsl:call-template name="tokenize">
                                             <xsl:with-param name="text" select="substring(normalize-space($opis_bez_tagow),1,$dlugosc_opisu)" />
                                          </xsl:call-template>
                                       </xsl:variable>
                                       <xsl:choose>
                                          <xsl:when test="$opis_do_kropki = ''">
                                             <!-- Nie ma przed kropka nic wiec podajemy co mamy bo mozliwe ze
                                                  wgl nie ma kropki lool-->
                                             <xsl:text disable-output-escaping="yes">&lt;![CDATA[</xsl:text>
                                             <xsl:value-of select="normalize-space($opis_bez_tagow)" />
                                             <xsl:if test="string-length(normalize-space($opis_bez_tagow)) &lt; $minimalna_dlugosc_opisu_dla_parametrow and $from_parameters != ''">
                                                <xsl:text>&#xa;</xsl:text>
                                                <xsl:value-of select="description/name" />
                                                <xsl:value-of select="$from_parameters" />
                                             </xsl:if>
                                             <xsl:text disable-output-escaping="yes">]]&gt;</xsl:text>
                                          </xsl:when>
                                          <xsl:otherwise>
                                             <xsl:text disable-output-escaping="yes">&lt;![CDATA[</xsl:text>
                                             <xsl:value-of select="normalize-space($opis_do_kropki)" />
                                             <xsl:if test="string-length(normalize-space($opis_do_kropki)) &lt; $minimalna_dlugosc_opisu_dla_parametrow and $from_parameters != ''">
                                                <xsl:text>&#xa;</xsl:text>
                                                <xsl:value-of select="description/name" />
                                                <xsl:value-of select="$from_parameters" />
                                             </xsl:if>
                                             <xsl:text disable-output-escaping="yes">]]&gt;</xsl:text>
                                          </xsl:otherwise>
                                       </xsl:choose>
                                    </xsl:otherwise>
                                 </xsl:choose>
                              </xsl:otherwise>
                           </xsl:choose>
                            </desc>
                            <attrs>
                                <a name="Rozmiar">uniwersalny</a>
                                <xsl:if test="producer/@name != ''">
                                    <a name="Producent">
                                        <xsl:value-of select="producer/@name"/>
                                    </a>
                                </xsl:if>
                                <xsl:if test="sizes/size[1]/@code != ''">
                                    <a name="Kod_producenta">
                                        <xsl:value-of select="sizes/size[1]/@code"/>
                                    </a>
                                </xsl:if>

                        <xsl:if test="parameters/parameter[@name = 'Autorzy']/value/@name != ''">
                           <a name="Autor">
                              <xsl:value-of select="parameters/parameter[@name = 'Autorzy']/value/@name"/>
                           </a>
                        </xsl:if>
                                
                                <xsl:variable name="code_producer_variable">
                                    <xsl:value-of select="sizes/size[1]/@code_producer"></xsl:value-of>
                                </xsl:variable>
                                <xsl:if test="$code_producer_variable != ''">
                                    <a name="EAN">
                                        <xsl:choose>
                                            <xsl:when test="@producer_code_standard='OTHER'">
                                                <xsl:value-of select="substring-before(substring-after($code_producer_variable, substring-before($code_producer_variable, substring(translate($code_producer_variable, '0', ''), 1, 1))),'_')" />
                                            </xsl:when>
                                            <xsl:when test="@producer_code_standard='ISBN13'">
                                                <xsl:value-of select="$code_producer_variable"/>
                                            </xsl:when>
                                        </xsl:choose>
                                    </a>
                                    <xsl:choose>
                                        <xsl:when test="contains(translate(description/name,  $uppercase,$lowercase),'audiobook')">
                                            <a name="Wersja">
                                                <![CDATA[audiobook (MP3)]]>
                                            </a>
                                        </xsl:when>
                                        <xsl:when test="contains(translate(description/name,  $uppercase,$lowercase),'ebook')">
                                            <a name="Wersja">
                                                <![CDATA[ebook (PDF)]]>
                                            </a>
                                        </xsl:when>
                                    </xsl:choose>
                                </xsl:if>
                                <xsl:for-each select="parameters/parameter">
                                    <xsl:if test="value[1]/@name != '' and @name != 'Autorzy'">
                                        <a>
                                            <xsl:attribute name="name">
                                                <xsl:value-of select="@name"/>
                                            </xsl:attribute>
                                            <xsl:value-of select="value[1]/@name"/>
                                        </a>
                                    </xsl:if>
                                </xsl:for-each>
                                
                                <xsl:if test="iaiext:responsible_entity/producer/code != ''">
                                    <a name="Producent odpowiedzialny">
                                        <xsl:value-of select="iaiext:responsible_entity/producer/@id"/>
                                    </a>
                                </xsl:if>
                                <xsl:if test="iaiext:responsible_entity/persons/person/code != ''">
                                    <a name="Podmiot odpowiedzialny">
                                        <xsl:value-of select="iaiext:responsible_entity/persons/person/@id"/>
                                    </a>
                                </xsl:if>
                            </attrs>
                        </o>
                        <!-- Koniec virtualnego towaru  and @type != 'virtual'-->
                    </xsl:when>
                    <xsl:when test="string-length($stocksGobalCheck) = 0">
                    </xsl:when>
                    <xsl:otherwise>
                        <o>
                            <!-- <xsl:attribute name="basket">0</xsl:attribute> -->
                            <!-- <xsl:for-each select="parameters/parameter">
                      <xsl:choose>
                          <xsl:when test="@name = 'Ceneo kup teraz'">
                              <xsl:choose>
                                  <xsl:when test="value/@name = '1'">
                                  <xsl:attribute name="basket">1</xsl:attribute>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <xsl:attribute name="basket">0</xsl:attribute>
                                    </xsl:otherwise>
                              </xsl:choose>
                          </xsl:when>
                      </xsl:choose>
                    </xsl:for-each> -->
                            <xsl:attribute name="id">
                                <xsl:value-of select="@id"/>
                            </xsl:attribute>
                            <xsl:attribute name="url">
                                <xsl:value-of select="card/@url"/></xsl:attribute>
                            <xsl:attribute name="price">
                                <xsl:choose>
                                    <xsl:when test="iaiext:pricecomparator_price/iaiext:site/@gross">
                                        <xsl:value-of select="iaiext:pricecomparator_price/iaiext:site/@gross"/>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <xsl:value-of select="price/@gross"/>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </xsl:attribute>
                            <xsl:choose>
                                <xsl:when test="iaiext:delivery_time/@unit = 'minute' or iaiext:delivery_time/@unit = 'hour'">
                                    <xsl:attribute name="avail">1</xsl:attribute>
                                </xsl:when>
                                <xsl:when test="(iaiext:delivery_time/iaiext:time/@days = 1 or iaiext:delivery_time/iaiext:time/@days = 0) and iaiext:delivery_time/@unit = 'day'">
                                    <xsl:attribute name="avail">1</xsl:attribute>
                                </xsl:when>
                                <xsl:when test="iaiext:delivery_time/iaiext:time/@days = 2 and iaiext:delivery_time/@unit = 'day' or iaiext:delivery_time/iaiext:time/@days = 3 and iaiext:delivery_time/@unit = 'day'">
                                    <xsl:attribute name="avail">3</xsl:attribute>
                                </xsl:when>
                                <xsl:when test="iaiext:delivery_time/iaiext:time/@days > 3 and iaiext:delivery_time/iaiext:time/@days &lt;= 7 and iaiext:delivery_time/@unit = 'day'">
                                    <xsl:attribute name="avail">7</xsl:attribute>
                                </xsl:when>
                                <xsl:when test="iaiext:delivery_time/iaiext:time/@days > 7 and iaiext:delivery_time/iaiext:time/@days &lt;= 14 and iaiext:delivery_time/@unit = 'day'">
                                    <xsl:attribute name="avail">14</xsl:attribute>
                                </xsl:when>
                                <xsl:otherwise>
                                    <xsl:attribute name="avail">99</xsl:attribute>
                                </xsl:otherwise>
                            </xsl:choose>
                            <xsl:attribute name="set">
                                <xsl:choose>
                                    <xsl:when test="bundled">1</xsl:when>
                                    <xsl:otherwise>0</xsl:otherwise>
                                </xsl:choose>
                            </xsl:attribute>
                            <xsl:if test="sizes/size[1]/@weight div 1000 > 0">
                                <xsl:attribute name="weight">
                                    <xsl:value-of select="sizes/size[1]/@weight div 1000"/>
                                </xsl:attribute>
                            </xsl:if>
                            <xsl:attribute name="stock">
                                <xsl:choose>
                                    <xsl:when test="contains($stocksGobalCheck,'-1') and string-length($stocksGobalCheck) &gt;0">
                                        <xsl:text>999999</xsl:text>
                                    </xsl:when>
                                    <xsl:when test="string-length($stocksGobalCheck) = 0">
                                        <xsl:text>0</xsl:text>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <xsl:value-of select="sum(sizes/size/stock[@id = '1' or @id = '0' or @id = '2' or @id = '3' or @id = '4' or @id = '5' or @id = '6' or @id = '7' or @id = '8' or @id = '9' or @id = '10' or @id = '-1' or @id = '-2' or @id = '-3']/@available_stock_quantity)"></xsl:value-of>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </xsl:attribute>
                            <cat>
                                <xsl:value-of select="translate(category/@name, '&gt;', '\')"/>
                            </cat>
                            <name>
                                <xsl:value-of select="description/name"/>
                            </name>
                            <imgs>
                                <xsl:variable name="vLowest">
                                    <xsl:for-each select="images/large/image/@iaiext:priority">
                                        <xsl:sort data-type="number"/>
                                        <xsl:if test="position()=1">
                                            <xsl:value-of select="."/>
                                        </xsl:if>
                                    </xsl:for-each>
                                </xsl:variable>
                                <xsl:for-each select="images/large/image">
                                    <xsl:choose>
                                        <xsl:when test="@iaiext:priority = number($vLowest)">
                                            <main>
                                                <xsl:attribute name="url">
                                                    <xsl:value-of select="@url"></xsl:value-of>
                                                </xsl:attribute>
                                            </main>
                                        </xsl:when>
                                        <xsl:otherwise>
                                            <i>
                                                <xsl:attribute name="url">
                                                    <xsl:value-of select="@url"></xsl:value-of>
                                                </xsl:attribute>
                                            </i>
                                        </xsl:otherwise>
                                    </xsl:choose>
                                </xsl:for-each>
                                <xsl:if test="images/large/image[2]/@url != ''">
                                </xsl:if>
                            </imgs>
                            <desc>
                        
                        <!-- Opis -->
                        <!-- 2026.07.08 MD -->
                        <xsl:variable name="from_parameters_raw">
                           <xsl:for-each select="parameters/parameter[@hide = 'n' and value/@name != '']">
                              <xsl:text>&#xa;</xsl:text>
                              <xsl:value-of select="@name" />
                              <xsl:text>: </xsl:text>
                              <xsl:for-each select="value">
                                 <xsl:value-of select="@name" />
                                 <xsl:text>; </xsl:text>
                              </xsl:for-each>
                           </xsl:for-each>
                        </xsl:variable>
                        <xsl:variable name="from_parameters">
                           <xsl:choose>
                              <xsl:when test="$from_parameters_raw != ''">
                                 <xsl:call-template name="tokenize">
                                    <xsl:with-param name="text" select="substring($from_parameters_raw, 1, $dlugosc_opisu_z_parametrow)" />
                                    <xsl:with-param name="delimiter" select="';'" />
                                 </xsl:call-template>
                              </xsl:when>
                              <xsl:otherwise>
                                 <xsl:text></xsl:text>
                              </xsl:otherwise>
                           </xsl:choose>
                        </xsl:variable>
                           <xsl:choose>
                              <xsl:when test="description/short_desc = '' and description/long_desc = ''">
                                 <!-- nie jest git bo nie ma opisów  -->
                                 <xsl:if test="$from_parameters != ''">
                                    <xsl:value-of select="description/name" />
                                    <xsl:value-of select="$from_parameters" />
                                 </xsl:if>
                              </xsl:when>
                              <xsl:when test="description/short_desc = '' and string-length(normalize-space(description/long_desc)) > 0">
                                 <xsl:variable name = "opis_znormalilzowany">
                                    <xsl:call-template name="string-normalize-all">
                                       <xsl:with-param name="text" select="description/long_desc" tunnel="yes"/>
                                    </xsl:call-template>
                                 </xsl:variable>
                                 
                                 <xsl:variable name = "opis_bez_twardych_spacji">
                                    <xsl:call-template name="string-replace-all">
                                       <xsl:with-param name="text" select="$opis_znormalilzowany" tunnel="yes"/>
                                       <xsl:with-param name="replace" select="'&amp;nbsp;'" tunnel="yes"/>
                                       <xsl:with-param name="by" select="' '" tunnel="yes"/>
                                    </xsl:call-template>
                                 </xsl:variable>
                                 <xsl:variable name = "opis_bez_komentarzy">
                                    <xsl:call-template name="strip-tags">
                                       <xsl:with-param name="text" select="$opis_bez_twardych_spacji" />
                                       <xsl:with-param name="open" select="'&lt;!--'" />
                                       <xsl:with-param name="close" select="'--&gt;'" />
                                    </xsl:call-template>
                                 </xsl:variable>
                                 <xsl:variable name = "opis_bez_styli">
                                    <xsl:call-template name="strip-tags">
                                       <xsl:with-param name="text" select="$opis_bez_komentarzy" />
                                       <xsl:with-param name="open" select="'&lt;style'" />
                                       <xsl:with-param name="close" select="'&lt;/style&gt;'" />
                                    </xsl:call-template>
                                 </xsl:variable>
                                 <xsl:variable name = "opis_bez_zdjęć">
                                    <xsl:call-template name="strip-tags">
                                       <xsl:with-param name="text" select="$opis_bez_styli" />
                                       <xsl:with-param name="open" select="'&lt;img'" />
                                       <xsl:with-param name="close" select="'&quot;/&gt;'" />
                                    </xsl:call-template>
                                 </xsl:variable>
                                 <xsl:variable name = "opis_bez_tagow">
                                    <xsl:call-template name="strip-tags">
                                       <xsl:with-param name="text" select="$opis_bez_zdjęć" tunnel="yes"/>
                                    </xsl:call-template>
                                 </xsl:variable>
                                 <xsl:variable name="opis_do_kropki">
                                    <xsl:call-template name="tokenize">
                                       <xsl:with-param name="text" select="substring(normalize-space($opis_bez_tagow),1,$dlugosc_opisu)" />
                                    </xsl:call-template>
                                 </xsl:variable>
                                 <xsl:choose>
                                    <xsl:when test="$opis_do_kropki = ''">
                                       <!-- Nie ma przed kropka nic wiec podajemy co mamy bo mozliwe ze wgl nie
                                            ma kropki lool-->
                                       <xsl:text disable-output-escaping="yes">&lt;![CDATA[</xsl:text>
                                       <xsl:value-of select="normalize-space($opis_bez_tagow)" />
                                       <xsl:if test="string-length(normalize-space($opis_bez_tagow)) &lt; $minimalna_dlugosc_opisu_dla_parametrow and $from_parameters != ''">
                                          <xsl:text>&#xa;</xsl:text>
                                          <xsl:value-of select="description/name" />
                                          <xsl:value-of select="$from_parameters" />
                                       </xsl:if>
                                       <xsl:text disable-output-escaping="yes">]]&gt;</xsl:text>
                                    </xsl:when>
                                    <xsl:otherwise>
                                       <xsl:text disable-output-escaping="yes">&lt;![CDATA[</xsl:text>
                                       <xsl:value-of select="normalize-space($opis_do_kropki)" />
                                       <xsl:if test="string-length(normalize-space($opis_do_kropki)) &lt; $minimalna_dlugosc_opisu_dla_parametrow and $from_parameters != ''">
                                          <xsl:text>&#xa;</xsl:text>
                                          <xsl:value-of select="description/name" />
                                          <xsl:value-of select="$from_parameters" />
                                       </xsl:if>
                                       <xsl:text disable-output-escaping="yes">]]&gt;</xsl:text>
                                    </xsl:otherwise>
                                 </xsl:choose>
                              </xsl:when>
                              <xsl:otherwise>
                                 <!-- tutaj jeśli opis nie bedzie mial X znakow to zastapic go długim opisem mimo
                                      wszystko -->
                                 <!-- załóżmy -->
                                 <xsl:choose>
                                    <xsl:when test="string-length(description/short_desc) > $zignoruj_dlugi_opis_jesli_krotki_przekracza or description/long_desc = ''">
                                       <xsl:text disable-output-escaping="yes">&lt;![CDATA[</xsl:text>
                                       <xsl:value-of select="description/short_desc" />
                                       <xsl:if test="string-length(description/short_desc) &lt; $minimalna_dlugosc_opisu_dla_parametrow and $from_parameters != ''">
                                          <xsl:text>&#xa;</xsl:text>
                                          <xsl:value-of select="description/name" />
                                          <xsl:value-of select="$from_parameters" />
                                       </xsl:if>
                                       <xsl:text disable-output-escaping="yes">]]&gt;</xsl:text>
                                    </xsl:when>
                                    <xsl:otherwise>
                                       <xsl:variable name = "opis_znormalilzowany">
                                          <xsl:call-template name="string-normalize-all">
                                             <xsl:with-param name="text" select="description/long_desc" tunnel="yes"/>
                                          </xsl:call-template>
                                       </xsl:variable>
                                       
                                       <xsl:variable name = "opis_bez_twardych_spacji">
                                          <xsl:call-template name="string-replace-all">
                                             <xsl:with-param name="text" select="$opis_znormalilzowany" tunnel="yes"/>
                                             <xsl:with-param name="replace" select="'&amp;nbsp;'" tunnel="yes"/>
                                             <xsl:with-param name="by" select="' '" tunnel="yes"/>
                                          </xsl:call-template>
                                       </xsl:variable>
                                       <xsl:variable name = "opis_bez_komentarzy">
                                          <xsl:call-template name="strip-tags">
                                             <xsl:with-param name="text" select="$opis_bez_twardych_spacji" />
                                             <xsl:with-param name="open" select="'&lt;!--'" />
                                             <xsl:with-param name="close" select="'--&gt;'" />
                                          </xsl:call-template>
                                       </xsl:variable>
                                       <xsl:variable name = "opis_bez_styli">
                                          <xsl:call-template name="strip-tags">
                                             <xsl:with-param name="text" select="$opis_bez_komentarzy" />
                                             <xsl:with-param name="open" select="'&lt;style'" />
                                             <xsl:with-param name="close" select="'&lt;/style&gt;'" />
                                          </xsl:call-template>
                                       </xsl:variable>
                                       <xsl:variable name = "opis_bez_zdjęć">
                                          <xsl:call-template name="strip-tags">
                                             <xsl:with-param name="text" select="$opis_bez_styli" />
                                             <xsl:with-param name="open" select="'&lt;img'" />
                                             <xsl:with-param name="close" select="'&quot;/&gt;'" />
                                          </xsl:call-template>
                                       </xsl:variable>
                                       <xsl:variable name = "opis_bez_tagow">
                                          <xsl:call-template name="strip-tags">
                                             <xsl:with-param name="text" select="$opis_bez_zdjęć" tunnel="yes"/>
                                          </xsl:call-template>
                                       </xsl:variable>
                                       <xsl:variable name="opis_do_kropki">
                                          <xsl:call-template name="tokenize">
                                             <xsl:with-param name="text" select="substring(normalize-space($opis_bez_tagow),1,$dlugosc_opisu)" />
                                          </xsl:call-template>
                                       </xsl:variable>
                                       <xsl:choose>
                                          <xsl:when test="$opis_do_kropki = ''">
                                             <!-- Nie ma przed kropka nic wiec podajemy co mamy bo mozliwe ze
                                                  wgl nie ma kropki lool-->
                                             <xsl:text disable-output-escaping="yes">&lt;![CDATA[</xsl:text>
                                             <xsl:value-of select="normalize-space($opis_bez_tagow)" />
                                             <xsl:if test="string-length(normalize-space($opis_bez_tagow)) &lt; $minimalna_dlugosc_opisu_dla_parametrow and $from_parameters != ''">
                                                <xsl:text>&#xa;</xsl:text>
                                                <xsl:value-of select="description/name" />
                                                <xsl:value-of select="$from_parameters" />
                                             </xsl:if>
                                             <xsl:text disable-output-escaping="yes">]]&gt;</xsl:text>
                                          </xsl:when>
                                          <xsl:otherwise>
                                             <xsl:text disable-output-escaping="yes">&lt;![CDATA[</xsl:text>
                                             <xsl:value-of select="normalize-space($opis_do_kropki)" />
                                             <xsl:if test="string-length(normalize-space($opis_do_kropki)) &lt; $minimalna_dlugosc_opisu_dla_parametrow and $from_parameters != ''">
                                                <xsl:text>&#xa;</xsl:text>
                                                <xsl:value-of select="description/name" />
                                                <xsl:value-of select="$from_parameters" />
                                             </xsl:if>
                                             <xsl:text disable-output-escaping="yes">]]&gt;</xsl:text>
                                          </xsl:otherwise>
                                       </xsl:choose>
                                    </xsl:otherwise>
                                 </xsl:choose>
                              </xsl:otherwise>
                           </xsl:choose>
                            </desc>
                            <attrs>
                                <a name="Rozmiar">uniwersalny</a>
                                <xsl:if test="producer/@name != ''">
                                    <a name="Producent">
                                        <xsl:value-of select="producer/@name"/>
                                    </a>
                                </xsl:if>
                                <xsl:if test="sizes/size[1]/@code != ''">
                                    <a name="Kod_producenta">
                                        <xsl:value-of select="sizes/size[1]/@code"/>
                                    </a>
                                </xsl:if>
                        
                        <xsl:if test="parameters/parameter[@name = 'Autorzy']/value/@name != ''">
                           <a name="Autor">
                              <xsl:value-of select="parameters/parameter[@name = 'Autorzy']/value/@name"/>
                           </a>
                        </xsl:if>
                                
                                <xsl:variable name="code_producer_variable">
                                    <xsl:value-of select="sizes/size[1]/@code_producer"></xsl:value-of>
                                </xsl:variable>
                                <xsl:if test="$code_producer_variable != ''">
                                    <xsl:choose>
                                        <xsl:when test="substring-after(substring-after($code_producer_variable, substring-before($code_producer_variable, substring(translate($code_producer_variable, '0', ''), 1, 1))),'_') = ''">
                                            <!-- Nie mamy nic -->
                                            <a name="EAN">
                                                <xsl:value-of select="substring-after($code_producer_variable, substring-before($code_producer_variable, substring(translate($code_producer_variable, '0', ''), 1, 1)))" />
                                            </a>
                                            <a name="Wersja">
                                                <![CDATA[towar fizyczny]]>
                                            </a>
                                        </xsl:when>
                                        <xsl:otherwise>
                                            <xsl:choose>
                                                <xsl:when test="substring-after(substring-after($code_producer_variable, substring-before($code_producer_variable, substring(translate($code_producer_variable, '0', ''), 1, 1))),'_') = '1'">
                                                    <a name="EAN">
                                                        <xsl:value-of select="substring-before(substring-after($code_producer_variable, substring-before($code_producer_variable, substring(translate($code_producer_variable, '0', ''), 1, 1))),'_')" />
                                                    </a>
                                                    <a name="Wersja">
                                                        <![CDATA[audiobook (MP3)]]>
                                                    </a>
                                                </xsl:when>
                                                <xsl:when test="substring-after(substring-after($code_producer_variable, substring-before($code_producer_variable, substring(translate($code_producer_variable, '0', ''), 1, 1))),'_') = '2'">
                                                    <a name="EAN">
                                                        <xsl:value-of select="substring-before(substring-after($code_producer_variable, substring-before($code_producer_variable, substring(translate($code_producer_variable, '0', ''), 1, 1))),'_')" />
                                                    </a>
                                                    <a name="Wersja">
                                                        <![CDATA[Audio CD]]>
                                                    </a>
                                                </xsl:when>
                                                <xsl:when test="substring-after(substring-after($code_producer_variable, substring-before($code_producer_variable, substring(translate($code_producer_variable, '0', ''), 1, 1))),'_') = '3'">
                                                    <a name="EAN">
                                                        <xsl:value-of select="substring-before(substring-after($code_producer_variable, substring-before($code_producer_variable, substring(translate($code_producer_variable, '0', ''), 1, 1))),'_')" />
                                                    </a>
                                                    <a name="Wersja">
                                                        <![CDATA[ebook (PDF)]]>
                                                    </a>
                                                </xsl:when>
                                                <xsl:when test="substring-after(substring-after($code_producer_variable, substring-before($code_producer_variable, substring(translate($code_producer_variable, '0', ''), 1, 1))),'_') = '4'">
                                                    <a name="EAN">
                                                        <xsl:value-of select="substring-before(substring-after($code_producer_variable, substring-before($code_producer_variable, substring(translate($code_producer_variable, '0', ''), 1, 1))),'_')" />
                                                    </a>
                                                    <a name="Wersja">
                                                        <![CDATA[DVD]]>
                                                    </a>
                                                </xsl:when>
                                                <xsl:otherwise>
                                                    <a name="EAN">
                                                        <xsl:value-of select="substring-after($code_producer_variable, substring-before($code_producer_variable, substring(translate($code_producer_variable, '0', ''), 1, 1)))" />
                                                    </a>
                                                </xsl:otherwise>
                                            </xsl:choose>
                                        </xsl:otherwise>
                                    </xsl:choose>
                                </xsl:if>
                                <xsl:for-each select="parameters/parameter">
                                    <xsl:if test="value[1]/@name != '' and @name != 'Autorzy'">
                                        <a>
                                            <xsl:attribute name="name">
                                                <xsl:value-of select="@name"/>
                                            </xsl:attribute>
                                            <xsl:value-of select="value[1]/@name"/>
                                        </a>
                                    </xsl:if>
                                </xsl:for-each>
                                <xsl:if test="iaiext:responsible_entity/producer/code != ''">
                                    <a name="Producent odpowiedzialny">
                                        <xsl:value-of select="iaiext:responsible_entity/producer/@id"/>
                                    </a>
                                </xsl:if>
                                <xsl:if test="iaiext:responsible_entity/persons/person/code != ''">
                                    <a name="Podmiot odpowiedzialny">
                                        <xsl:value-of select="iaiext:responsible_entity/persons/person/@id"/>
                                    </a>
                                </xsl:if>
                            </attrs>
                        </o>
                    </xsl:otherwise>
                </xsl:choose>
            </xsl:for-each>
        </offers>
    </xsl:template>   
   
   <!-- 2026.05.07  MD -->
   <xsl:template name="strip-tags">
      <xsl:param name="text" />
      <xsl:param name="open" select="'&lt;'" />
      <xsl:param name="close" select="'&gt;'" />
      <xsl:param name="depth" select="0" />
      <xsl:choose>
         <xsl:when test="contains($text, $open) and not(contains(substring-after($text, $open), $close))">
            <xsl:value-of select="normalize-space($text)" />
         </xsl:when>
         <xsl:when test="contains($text, $open) and $depth &lt; 1200">
            <xsl:value-of select="substring-before($text, $open)" />
            <xsl:text><![CDATA[ ]]></xsl:text>
            <xsl:call-template name="strip-tags">
               <xsl:with-param name="text" select="substring-after($text, $close)" />
               <xsl:with-param name="open" select="$open" />
               <xsl:with-param name="close" select="$close" />
               <xsl:with-param name="depth" select="$depth + 1" />
            </xsl:call-template>
         </xsl:when>
         <xsl:otherwise>
            <xsl:value-of select="normalize-space($text)" />
         </xsl:otherwise>
      </xsl:choose>
   </xsl:template>
   
   <xsl:template name="tokenize">
      <xsl:param name="text" />
      <xsl:param name="delimiter" select="'.'" />
      <xsl:param name="depth" select="0" />
      <xsl:choose>
         <xsl:when test="contains($text, $delimiter) and $depth &lt; 1000">
            <xsl:value-of select="substring-before($text, $delimiter)" />
            <xsl:value-of select="$delimiter" />
            <xsl:call-template name="tokenize">
               <xsl:with-param name="text" select="substring-after($text, $delimiter)" />
               <xsl:with-param name="delimiter" select="$delimiter" />
               <xsl:with-param name="depth" select="$depth + 1" />
            </xsl:call-template>
         </xsl:when>
      </xsl:choose>
   </xsl:template>
    
  <xsl:template name="string-replace-all">
        <xsl:param name="text" />
        <xsl:param name="replace" />
        <xsl:param name="by" />
        <xsl:param name="depth" select="0" />
        <xsl:choose>
            <xsl:when test="contains($text, $replace) and $depth &lt; 1000">
                <xsl:value-of select="substring-before($text,$replace)" />
                <xsl:value-of select="$by" />
                <xsl:call-template name="string-replace-all">
                    <xsl:with-param name="text" select="substring-after($text,$replace)" />
                    <xsl:with-param name="replace" select="$replace" />
                    <xsl:with-param name="by" select="$by" />
                    <xsl:with-param name="depth" select="$depth + 1" />
                </xsl:call-template>
            </xsl:when>
            <xsl:otherwise>
                <xsl:value-of select="$text" />
            </xsl:otherwise>
        </xsl:choose>
  </xsl:template>
   <!-- Normalizacja encji HTML → Unicode -->
   <xsl:template name="string-normalize-all">
      <xsl:param name="text"/>
      
      <xsl:variable name="step1">
         <xsl:call-template name="string-replace-all">
            <xsl:with-param name="text" select="$text"/>
            <xsl:with-param name="replace" select="'&amp;nbsp;'"/>
            <xsl:with-param name="by" select="' '"/>
         </xsl:call-template>
      </xsl:variable>
      <xsl:variable name="step2">
         <xsl:call-template name="string-replace-all">
            <xsl:with-param name="text" select="$step1"/>
            <xsl:with-param name="replace" select="'&amp;amp;'"/>
            <xsl:with-param name="by" select="'&amp;'"/>
         </xsl:call-template>
      </xsl:variable>
      <xsl:variable name="step3">
         <xsl:call-template name="string-replace-all">
            <xsl:with-param name="text" select="$step2"/>
            <xsl:with-param name="replace" select="'&amp;quot;'"/>
            <xsl:with-param name="by" select="'&quot;'"/>
         </xsl:call-template>
      </xsl:variable>
      <xsl:variable name="step4">
         <xsl:call-template name="string-replace-all">
            <xsl:with-param name="text" select="$step3"/>
            <xsl:with-param name="replace" select="'&amp;apos;'"/>
            <xsl:with-param name="by" select="&quot;'&quot;"/>
         </xsl:call-template>
      </xsl:variable>
      <xsl:variable name="step5">
         <xsl:call-template name="string-replace-all">
            <xsl:with-param name="text" select="$step4"/>
            <xsl:with-param name="replace" select="'&amp;lt;'"/>
            <xsl:with-param name="by" select="'&lt;'"/>
         </xsl:call-template>
      </xsl:variable>
      <xsl:variable name="step6">
         <xsl:call-template name="string-replace-all">
            <xsl:with-param name="text" select="$step5"/>
            <xsl:with-param name="replace" select="'&amp;gt;'"/>
            <xsl:with-param name="by" select="'&gt;'"/>
         </xsl:call-template>
      </xsl:variable>
      <xsl:variable name="step7">
         <xsl:call-template name="string-replace-all">
            <xsl:with-param name="text" select="$step6"/>
            <xsl:with-param name="replace" select="'&amp;eacute;'"/>
            <xsl:with-param name="by" select="'é'"/>
         </xsl:call-template>
      </xsl:variable>
      <xsl:variable name="step8">
         <xsl:call-template name="string-replace-all">
            <xsl:with-param name="text" select="$step7"/>
            <xsl:with-param name="replace" select="'&amp;oacute;'"/>
            <xsl:with-param name="by" select="'ó'"/>
         </xsl:call-template>
      </xsl:variable>
      <xsl:variable name="step9">
         <xsl:call-template name="string-replace-all">
            <xsl:with-param name="text" select="$step8"/>
            <xsl:with-param name="replace" select="'&amp;aacute;'"/>
            <xsl:with-param name="by" select="'á'"/>
         </xsl:call-template>
      </xsl:variable>
      <xsl:variable name="step10">
         <xsl:call-template name="string-replace-all">
            <xsl:with-param name="text" select="$step9"/>
            <xsl:with-param name="replace" select="'&amp;iacute;'"/>
            <xsl:with-param name="by" select="'í'"/>
         </xsl:call-template>
      </xsl:variable>
      <xsl:variable name="step11">
         <xsl:call-template name="string-replace-all">
            <xsl:with-param name="text" select="$step10"/>
            <xsl:with-param name="replace" select="'&amp;uacute;'"/>
            <xsl:with-param name="by" select="'ú'"/>
         </xsl:call-template>
      </xsl:variable>
      <xsl:variable name="step12">
         <xsl:call-template name="string-replace-all">
            <xsl:with-param name="text" select="$step11"/>
            <xsl:with-param name="replace" select="'&amp;ntilde;'"/>
            <xsl:with-param name="by" select="'ñ'"/>
         </xsl:call-template>
      </xsl:variable>
      <xsl:variable name="step13">
         <xsl:call-template name="string-replace-all">
            <xsl:with-param name="text" select="$step12"/>
            <xsl:with-param name="replace" select="'&amp;uuml;'"/>
            <xsl:with-param name="by" select="'ü'"/>
         </xsl:call-template>
      </xsl:variable>
      <xsl:variable name="step14">
         <xsl:call-template name="string-replace-all">
            <xsl:with-param name="text" select="$step13"/>
            <xsl:with-param name="replace" select="'&amp;ouml;'"/>
            <xsl:with-param name="by" select="'ö'"/>
         </xsl:call-template>
      </xsl:variable>
      <xsl:variable name="step15">
         <xsl:call-template name="string-replace-all">
            <xsl:with-param name="text" select="$step14"/>
            <xsl:with-param name="replace" select="'&amp;auml;'"/>
            <xsl:with-param name="by" select="'ä'"/>
         </xsl:call-template>
      </xsl:variable>
      <xsl:variable name="step16">
         <xsl:call-template name="string-replace-all">
            <xsl:with-param name="text" select="$step15"/>
            <xsl:with-param name="replace" select="'&amp;szlig;'"/>
            <xsl:with-param name="by" select="'ß'"/>
         </xsl:call-template>
      </xsl:variable>
      <xsl:variable name="step17">
         <xsl:call-template name="string-replace-all">
            <xsl:with-param name="text" select="$step16"/>
            <xsl:with-param name="replace" select="'&amp;copy;'"/>
            <xsl:with-param name="by" select="'©'"/>
         </xsl:call-template>
      </xsl:variable>
      <xsl:variable name="step18">
         <xsl:call-template name="string-replace-all">
            <xsl:with-param name="text" select="$step17"/>
            <xsl:with-param name="replace" select="'&amp;reg;'"/>
            <xsl:with-param name="by" select="'®'"/>
         </xsl:call-template>
      </xsl:variable>
