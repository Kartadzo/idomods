    {
      "parameters": {
        "jsCode": "const targetId = \"805fca92-5634-4b72-a379-a5b9111f3f74\";\nconst fields = $json.custom_fields || [];\nconst field = fields.find(f => f.id === targetId);\nreturn [{ json: { value: field ? field.value : null } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
