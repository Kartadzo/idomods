      ],
      "id": "7573e136-2fca-4a9b-8fd8-de9534d85cb4",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// Przepisanie pola \"Opiekun\" (Custom Field typu USERS) z zadania-rodzica na podzadanie.\n// Wejście: dane rodzica z węzła \"pobierz dane rodzica\".\n// Wyjście: gotowy JSON-string dla węzła ClickUp -> Task: Set Custom Field (Value Is JSON = true).\n//          Brak itemów (return []) = nie ma czego przepisać -> dalsze węzły się nie wykonają.\n\n// ID pola \"Opiekun\" (users) w przestrzeni \"wewnętrzne zadania\" (60747517)\nconst FIELD_ID = \"7e6d0b2e-0d6d-4284-af1a-63b49a9843d5\";\n\nconst parent = $json;\nconst child = $(\"pobierz dane nowego zadania\").item.json;\n\n// Szukamy po ID pola, nie po pozycji w tablicy - kolejność custom_fields nie jest stała.\nfunction readUsers(task) {\n  const cf = (task.custom_fields || []).find((f) => f.id === FIELD_ID);\n  const value = cf ? cf.value : null;\n  return Array.isArray(value) ? value : [];\n}\n\nconst parentUsers = readUsers(parent);\nconst childUsers = readUsers(child);\n\n// Rodzic nie ma opiekuna albo podzadanie już go ma - nie nadpisujemy.\nif (parentUsers.length === 0 || childUsers.length > 0) {\n  return [];\n}\n\nconst userIds = parentUsers\n  .map((u) => u && u.id)\n  .filter((id) => id !== null && id !== undefined);\n\nif (userIds.length === 0) {\n  return [];\n}\n\n// ClickUp dla pól typu \"users\" oczekuje przy ZAPISIE { \"add\": [...], \"rem\": [...] },\n// a nie tablicy [{ \"id\": ... }] - to jest format ODCZYTU z GET /task.\nreturn [\n  {\n    json: {\n      fieldId: FIELD_ID,\n      userIds: userIds,\n      valueJson: JSON.stringify({ add: userIds, rem: [] }),\n    },\n    pairedItem: 0,\n  },\n];\n"
      },
